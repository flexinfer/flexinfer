# syntax=docker/dockerfile:1.7
# Build stage
ARG RUNTIME_REGISTRY=registry.harbor.lan
FROM golang:1.25.10-alpine AS builder

RUN apk add --no-cache git ca-certificates
ENV GOWORK=off \
    GOPRIVATE=gitlab.flexinfer.ai/* \
    GONOSUMDB=gitlab.flexinfer.ai/* \
    GONOPROXY=gitlab.flexinfer.ai/*

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=secret,id=ci_job_token,required=false \
    --mount=type=secret,id=gitlab_token,required=false \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eu; \
    token=""; \
    token_user=""; \
    if [ -s /run/secrets/gitlab_token ]; then \
      token="$(cat /run/secrets/gitlab_token)"; \
      token_user="oauth2"; \
    elif [ -s /run/secrets/ci_job_token ]; then \
      token="$(cat /run/secrets/ci_job_token)"; \
      token_user="gitlab-ci-token"; \
    fi; \
    if [ -n "$token" ]; then \
      git config --global url."https://${token_user}:${token}@gitlab.flexinfer.ai/".insteadOf "https://gitlab.flexinfer.ai/"; \
    fi; \
    go mod download

COPY . .

# See Dockerfile for why the secret mount + git config is repeated on the build steps.
ARG MCP_BUILD_JOBS=4
RUN --mount=type=secret,id=ci_job_token,required=false \
    --mount=type=secret,id=gitlab_token,required=false \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eu; \
    token=""; \
    token_user=""; \
    if [ -s /run/secrets/gitlab_token ]; then \
      token="$(cat /run/secrets/gitlab_token)"; \
      token_user="oauth2"; \
    elif [ -s /run/secrets/ci_job_token ]; then \
      token="$(cat /run/secrets/ci_job_token)"; \
      token_user="gitlab-ci-token"; \
    fi; \
    if [ -n "$token" ]; then \
      git config --global url."https://${token_user}:${token}@gitlab.flexinfer.ai/".insteadOf "https://gitlab.flexinfer.ai/"; \
    fi; \
    CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -ldflags="-s -w" -o /out/custom-server ./cmd/custom-server

RUN --mount=type=secret,id=ci_job_token,required=false \
    --mount=type=secret,id=gitlab_token,required=false \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -eu; \
    token=""; \
    token_user=""; \
    if [ -s /run/secrets/gitlab_token ]; then \
      token="$(cat /run/secrets/gitlab_token)"; \
      token_user="oauth2"; \
    elif [ -s /run/secrets/ci_job_token ]; then \
      token="$(cat /run/secrets/ci_job_token)"; \
      token_user="gitlab-ci-token"; \
    fi; \
    if [ -n "$token" ]; then \
      git config --global url."https://${token_user}:${token}@gitlab.flexinfer.ai/".insteadOf "https://gitlab.flexinfer.ai/"; \
    fi; \
    mkdir -p /out/services/loom-core/bin && \
    find cmd -mindepth 1 -maxdepth 1 -type d -name 'mcp-*' | xargs -n1 basename | \
      xargs -P"${MCP_BUILD_JOBS}" -I{} sh -c \
        'CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -ldflags="-s -w" -o "/out/services/loom-core/bin/$1" "./cmd/$1"' _ {}

# Runtime stage
FROM ${RUNTIME_REGISTRY}/dockerhub-cache/library/alpine:3.21

RUN apk add --no-cache ca-certificates kubectl

RUN adduser -D -u 1000 mcp
USER mcp

WORKDIR /app

COPY --from=builder /out/custom-server /app/custom-server
COPY --from=builder /out/services/loom-core/bin /app/services/loom-core/bin

EXPOSE 8080

ENTRYPOINT ["/app/custom-server"]
