# syntax=docker/dockerfile:1.7
# Build stage
ARG RUNTIME_REGISTRY=registry.harbor.lan
FROM golang:1.25.8-alpine AS builder

RUN apk add --no-cache git ca-certificates
ENV GOWORK=off

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=secret,id=ci_job_token,required=false \
    --mount=type=secret,id=gitlab_token,required=false \
    set -eu; \
    token=""; \
    token_user=""; \
    if [ -s /run/secrets/ci_job_token ]; then \
      token="$(cat /run/secrets/ci_job_token)"; \
      token_user="gitlab-ci-token"; \
    elif [ -s /run/secrets/gitlab_token ]; then \
      token="$(cat /run/secrets/gitlab_token)"; \
      token_user="oauth2"; \
    fi; \
    if [ -n "$token" ]; then \
      git config --global url."https://${token_user}:${token}@gitlab.flexinfer.ai/".insteadOf "https://gitlab.flexinfer.ai/"; \
    fi; \
    go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -ldflags="-s -w" -o /out/custom-server ./cmd/custom-server

RUN mkdir -p /out/services/loom-core/bin && \
    for d in cmd/mcp-*; do \
      name="$(basename "$d")"; \
      CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -ldflags="-s -w" -o "/out/services/loom-core/bin/$name" "./$d"; \
    done

# Runtime stage
FROM ${RUNTIME_REGISTRY}/dockerhub-cache/library/alpine:3.21

RUN apk add --no-cache ca-certificates kubectl

RUN adduser -D -u 1000 mcp
USER mcp

WORKDIR /app

COPY --from=builder /out/custom-server /app/custom-server
COPY --from=builder /out/services/loom-core/bin /app/services/loom-core/bin

EXPOSE 8080

ENTRYPOINT ["/app/custom-server"]
