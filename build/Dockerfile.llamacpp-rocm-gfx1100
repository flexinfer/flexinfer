# llama.cpp Docker image for AMD gfx1100 (RX 7900 series, RDNA3)
# Built from source with GGML_HIP=ON targeting gfx1100
#
# Build command (on the GPU builder):
#   docker --context 7900xtx build -f build/Dockerfile.llamacpp-rocm-gfx1100 \
#     -t registry.harbor.lan/library/llamacpp:rocm-gfx1100-b11847 .
#
# ROCm 7.2.3 is the userspace the fleet's vLLM 0.32 runtime already serves
# from on both gfx1100 hosts (S1, 2026-10-24: 5930k kernel 6.14.9, 7900xtx
# kernel 7.0.0-38). b8173..b10453 built on 6.4.4.
ARG ROCM_VERSION=7.2.3
FROM rocm/dev-ubuntu-24.04:${ROCM_VERSION} AS builder

# ggml forwards GPU_TARGETS to CMAKE_HIP_ARCHITECTURES (AMDGPU_TARGETS is the
# deprecated alias).
ARG GPU_TARGETS=gfx1100

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    build-essential \
    curl \
    hipblas-dev \
    rocblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone llama.cpp at pinned release.
# b11847 (2026-10-24; S5 refresh from b10453 / 2026-08, research
# .loom/10-research-gfx1100-next-feature-2026-10-23.md §4 row 3): carries
# the `--spec-type draft-mtp` path for Qwen3.5/3.8 GGUFs that keep their MTP
# head, DFlash2 (`draft-dflash`), the ngram-mod/ngram-cache drafters, and the
# muse-glimmer arch + ATEM tool-call parser that b10353+ already had.
ARG LLAMACPP_VERSION=b11847
WORKDIR /opt/src
RUN git clone --depth 1 --branch ${LLAMACPP_VERSION} https://github.com/ggml-org/llama.cpp.git

# Build llama.cpp with HIP (ROCm) support.
# GGML_NATIVE=OFF: no -march=native, the 5930k host is a Haswell-E Xeon, not
# the Zen3 build node. Tests are skipped (tools incl. llama-server,
# llama-bench and llama-cli are what the image ships).
WORKDIR /opt/src/llama.cpp
RUN HIPCXX="$(hipconfig -l)/clang" HIP_PATH="$(hipconfig -R)" \
    cmake -B build -G Ninja \
    -DGGML_HIP=ON \
    -DGGML_NATIVE=OFF \
    -DGPU_TARGETS=${GPU_TARGETS} \
    -DLLAMA_BUILD_TESTS=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j$(nproc)

# Runtime stage
FROM rocm/dev-ubuntu-24.04:${ROCM_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# ROCm environment for gfx1100
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV HIP_VISIBLE_DEVICES=0
ENV ROCR_VISIBLE_DEVICES=0

# Install runtime ROCm libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    hipblas \
    rocblas \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Copy built binaries and shared libraries
COPY --from=builder /opt/src/llama.cpp/build/bin/ /opt/src/llama.cpp/build/bin/
ENV LD_LIBRARY_PATH=/opt/src/llama.cpp/build/bin

# Create model directory
RUN mkdir -p /models

WORKDIR /opt/src/llama.cpp

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["/opt/src/llama.cpp/build/bin/llama-server", "--host", "0.0.0.0", "--port", "8080"]
