# vLLM-Omni for AMD gfx1100 (RX 7900 series) — multimodal generation
# Layers vllm-omni pip package on top of the prebuilt Navi vLLM image.
#
# Base: ROCm 7.2, PyTorch 2.9, vLLM ~0.14.0rc1.dev2 (Navi-optimized)
# Omni: vllm-omni 0.14.0 (pip, with attention registry shim)
#
# Key difference from FA image: Triton FA is OFF. The omni pipeline uses
# different attention code paths that are not validated with Triton FA on RDNA3.
#
# Capabilities: text gen, image gen (DiT/diffusion), audio/TTS, omni models
# Target models: Qwen2.5-Omni-7B (14GB), Qwen2.5-Omni-3B (6GB)
#
# Build: docker build -f build/Dockerfile.vllm-omni-rocm-gfx1100 -t vllm-omni:rocm-gfx1100 .

ARG BASE_IMAGE=rocm/vllm-dev:rocm7.2_navi_ubuntu24.04_py3.12_pytorch_2.9_vllm_0.14.0rc0
FROM ${BASE_IMAGE}

ENV PYTORCH_ROCM_ARCH=gfx1100
ENV DEBIAN_FRONTEND=noninteractive

# ROCm environment for gfx1100 (RDNA3)
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
# Faster kernel dispatch on ROCm
ENV HIP_FORCE_DEV_KERNARG=1

# Triton flash attention for RDNA3 (via AOTriton, base image has
# FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE). Enabled for perf testing.
ENV VLLM_USE_TRITON_FLASH_ATTN=1
# AWQ quantization via Triton (required for AWQ models on ROCm)
ENV VLLM_USE_TRITON_AWQ=1
# AITER: disabled (MI300X-optimized, not RDNA3)
ENV VLLM_ROCM_USE_AITER=0

# Shim: vllm.v1.attention.backends.registry module
# The AMD Navi base image uses a vLLM fork (~0.14.0rc1.dev2) that predates
# the attention registry restructure (vllm-project/vllm#31916, Jan 9 2026).
# vllm-omni 0.14.0 imports AttentionBackendEnum from this module.
# This shim provides the minimal registry API using pure Python — no compiled
# extensions needed. Sourced from upstream vLLM v0.14.0 stable.
COPY build/vllm-omni-shims/registry.py /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/registry.py

# Install vllm-omni on top of base vLLM
RUN pip install --no-cache-dir \
    vllm-omni==0.14.0 \
    diffusers>=0.30.0 \
    pillow \
    sentencepiece \
    protobuf \
    soundfile \
    sox \
    "numpy<2"

# Compat patch: vllm-omni 0.14.0 expects external_req_id on EngineCoreRequest
# but the AMD Navi base image's vLLM (~0.14.0rc1.dev2) predates vllm-project/vllm#27987
# (Dec 23 2025) which added this field. Use getattr() for safe fallback.
RUN sed -i 's/external_req_id=request\.external_req_id/external_req_id=getattr(request, "external_req_id", None)/' \
    /opt/venv/lib/python3.12/site-packages/vllm_omni/request.py

# onnxruntime-rocm for omni audio pipelines (replaces onnxruntime)
RUN pip uninstall -y onnxruntime 2>/dev/null; \
    pip install --no-cache-dir onnxruntime-rocm 2>/dev/null || true

WORKDIR /workspace
RUN mkdir -p /models

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# vLLM-Omni entrypoint: `vllm serve --omni`
# Falls back to standard vLLM serve for non-omni models.
ENTRYPOINT ["vllm", "serve"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
