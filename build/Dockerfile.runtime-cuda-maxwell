# Unified flexinfer-runtime image for NVIDIA Maxwell (sm_52)
# Contains: flexinfer-runtime manager + llamacpp + ollama
#
# Build command:
#   docker build -f build/Dockerfile.runtime-cuda-maxwell \
#     -t registry.harbor.lan/flexinfer/runtime:cuda-maxwell .
#
# Notes:
#   - Maxwell (sm_52) only supports llamacpp + ollama (no vLLM/diffusers)
#   - CUDA 11.8 (last toolkit with full sm_52 support)
#   - No flash attention (requires CC >= 7.0)

# ── Stage 1: Build flexinfer-runtime Go binary ──────────────────────
FROM golang:1.26.0 AS go-builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY backend/ backend/
COPY internal/ internal/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY scheduler/ scheduler/
COPY agents/ agents/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o /runtime cmd/flexinfer-runtime/main.go

# ── Stage 2: Build llama.cpp with CUDA for Maxwell ──────────────────
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04 AS llamacpp-builder

ARG LLAMACPP_VERSION=b8173
ARG CUDA_ARCHITECTURES="52"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build build-essential curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/src
RUN git clone --depth 1 --branch ${LLAMACPP_VERSION} https://github.com/ggml-org/llama.cpp.git

WORKDIR /opt/src/llama.cpp
# llama.cpp b8173+ uses CUDA Driver API (VMM: cuMemCreate, cuMemMap).
# Link stubs so the linker can resolve these symbols at build time.
RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/libcuda.so.1 && ldconfig
RUN cmake -B build -G Ninja \
    -DGGML_CUDA=ON \
    -DGGML_NATIVE=OFF \
    -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES} \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j$(nproc)

# ── Stage 3: Build ollama with CUDA for Maxwell ────────────────────
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04 AS ollama-builder

ARG OLLAMA_VERSION=v0.17.4
ARG GO_VERSION=1.25.7

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake make gcc g++ curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /build
RUN git clone --depth 1 --branch "${OLLAMA_VERSION}" https://github.com/ollama/ollama.git .

ENV CUDA_ARCHITECTURES="50;52"
ENV CMAKE_CUDA_ARCHITECTURES="50;52"
ENV CGO_ENABLED=1
RUN go generate ./... && go build -trimpath -o /build/ollama .

# ── Stage 4: Runtime image ──────────────────────────────────────────
FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Runtime GPU vendor/arch for the flexinfer-runtime manager
ENV GPU_VENDOR=nvidia
ENV GPU_ARCH=sm_52

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/*

# ── Copy llama.cpp binary ───────────────────────────────────────────
COPY --from=llamacpp-builder /opt/src/llama.cpp/build/bin/ /opt/llamacpp/bin/
ENV PATH="/opt/llamacpp/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llamacpp/bin:${LD_LIBRARY_PATH}"

# ── Copy ollama binary ──────────────────────────────────────────────
COPY --from=ollama-builder /build/ollama /usr/local/bin/ollama
ENV OLLAMA_MODELS=/models/ollama

# ── Copy flexinfer-runtime binary ───────────────────────────────────
COPY --from=go-builder /runtime /usr/local/bin/flexinfer-runtime

RUN mkdir -p /models /var/lib/flexinfer/compile-cache

WORKDIR /workspace

EXPOSE 8080 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

ENTRYPOINT ["tini", "--", "flexinfer-runtime"]
CMD ["--listen", ":8080", "--gpu-vendor", "nvidia", "--gpu-arch", "sm_52"]
