FROM golang:1.25.5 as builder
WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY backend/ backend/
COPY pkg/ pkg/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o proxy cmd/flexinfer-proxy/main.go

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /
COPY --from=builder /workspace/proxy .
USER 65532:65532
ENTRYPOINT ["/proxy"]
