# Diffusers API Server for NVIDIA GPUs (CUDA)
# Provides OpenAI-compatible /v1/images/generations endpoint.
#
# Notes:
# - Targets older NVIDIA GPUs by pinning to CUDA 11.8 PyTorch base.
# - Defaults to 512x512 output to fit 6GB-class GPUs (override via request `size`).

ARG PYTORCH_IMAGE=pytorch/pytorch:2.1.2-cuda11.8-cudnn8-runtime
FROM ${PYTORCH_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Avoid optional GPU deps that frequently break on older cards.
ENV XFORMERS_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    diffusers==0.30.2 \
    transformers==4.44.2 \
    accelerate==0.33.0 \
    safetensors \
    pillow \
    pydantic \
    python-multipart \
    aiofiles && \
    pip install --no-cache-dir --force-reinstall "numpy<2"

# Copy the API server (extracted from heredoc for better DX)
COPY build/server-diffusers-cuda.py /app/server.py

ENV PORT=8000
EXPOSE 8000

CMD ["python", "/app/server.py"]
