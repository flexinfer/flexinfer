# llama.cpp Docker image for AMD gfx906 (Radeon VII, Vega20)
# Built from source with GGML_HIP=ON targeting gfx906
#
# Includes a patch for hipMemGetInfo returning hipErrorInvalidValue on
# gfx906 when VMM is not supported (ROCm 6.x). The patch falls back to
# a hardcoded 16 GB VRAM size instead of aborting.
#
# Build command (on GPU node with docker):
#   docker --context 7900xtx build -f build/Dockerfile.llamacpp-rocm-gfx906 \
#     -t registry.harbor.lan/library/llamacpp:rocm-gfx906-patched build/

ARG ROCM_VERSION=6.4.4
FROM rocm/dev-ubuntu-24.04:${ROCM_VERSION} AS builder

ARG AMDGPU_TARGETS=gfx906

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    cmake \
    ninja-build \
    build-essential \
    curl \
    hipblas-dev \
    rocblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone llama.cpp
WORKDIR /opt/src
RUN git clone --depth 1 https://github.com/ggerganov/llama.cpp.git

# Patch: make hipMemGetInfo failure non-fatal on gfx906.
# Replace CUDA_CHECK(cudaMemGetInfo(...)) with a try/fallback that
# returns 16 GB when the call fails (VMM not supported on Vega20).
WORKDIR /opt/src/llama.cpp
COPY build/patch-hipmemgetinfo.sh /tmp/
RUN chmod +x /tmp/patch-hipmemgetinfo.sh && /tmp/patch-hipmemgetinfo.sh

# Build llama.cpp with HIP (ROCm) support
# GGML_NATIVE=OFF prevents -march=native so the binary runs on older CPUs
# (the Radeon VII host has a Broadwell Xeon, not the Zen3 build node).
RUN cmake -B build -G Ninja \
    -DGGML_HIP=ON \
    -DAMDGPU_TARGETS=${AMDGPU_TARGETS} \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_NATIVE=OFF \
    && cmake --build build --config Release -j$(nproc)

# Runtime stage
FROM rocm/dev-ubuntu-24.04:${ROCM_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

# ROCm environment for gfx906 (Radeon VII / Vega20)
# HSA_ENABLE_SDMA=0 prevents DMA engine issues on Vega20
# HSA_USE_SVM=0 works around SVM-related issues on gfx906
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm/hip
ENV HSA_ENABLE_SDMA=0
ENV HSA_USE_SVM=0
ENV PYTORCH_ROCM_ARCH=gfx906

# Install runtime ROCm libraries + Python (for HF prefetch jobs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    hipblas \
    rocblas \
    curl \
    tini \
    python3 \
    python3-pip \
    && pip3 install --break-system-packages --no-cache-dir huggingface_hub \
    && rm -rf /var/lib/apt/lists/*

# Copy built binaries (internal libs are statically linked; ROCm shared libs
# come from the runtime stage's hipblas/rocblas packages)
COPY --from=builder /opt/src/llama.cpp/build/bin/ /opt/src/llama.cpp/build/bin/

# Create model directory (run as root; K8s securityContext handles the user)
RUN mkdir -p /models && chmod 777 /models

WORKDIR /opt/src/llama.cpp

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["/opt/src/llama.cpp/build/bin/llama-server", "--host", "0.0.0.0", "--port", "8080"]
