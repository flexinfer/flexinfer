# Dedicated gfx1100 GPTQ canary runtime.
#
# vLLM 0.23 was the first upstream release with the native RDNA3 W4A16 HIP
# kernel; 0.26.0 added the hybrid-GDN mamba-block-split clamp (upstream PR
# #47782) that the ngram speculative-decoding re-canary depends on
# (services/flexinfer#66). This image now tracks 0.32.0 (2026-10-23, slice S1 of
# .loom/10-research-gfx1100-next-feature-2026-10-23.md): it carries the GDN
# gate/speculative-token alignment (#51812, 0.28), the fused GDN MTP path for
# all Qwen head ratios (#52539, 0.29), the opt-in RDNA segmented-attention
# backend ROCM_SEGMENTED_ATTN (#59132) and the ROCm sleep-mode VMM fix
# (#60367). Keep this image separate from the legacy 0.17 serving persona
# until full-checkpoint logit/coherence and throughput acceptance passes.
ARG BASE_IMAGE=vllm/vllm-openai-rocm:v0.32.0
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF=v0.32.0

FROM ${BASE_IMAGE}

ARG GPU_ARCH=gfx1100
ARG VLLM_REPO
ARG VLLM_REF

ENV GPU_VENDOR=amd \
    GPU_ARCH=${GPU_ARCH} \
    HSA_OVERRIDE_GFX_VERSION=11.0.0 \
    PYTORCH_ROCM_ARCH=${GPU_ARCH} \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    VLLM_ROCM_USE_AITER=0

USER root

# Whether to rebuild vLLM's native extensions from source for ${GPU_ARCH}:
#   auto   — probe the base image first (default). The published v0.26 ROCm
#            wheel omitted the compiled gfx1100 GPTQ op and needed the rebuild;
#            vllm/vllm-openai-rocm:v0.32.0 ships _rocm_C with gfx1100 code
#            objects (PYTORCH_ROCM_ARCH lists gfx1100 in upstream's
#            docker/Dockerfile.rocm_base; verified 2026-10-23: 12 bundles,
#            gptq_gemm_rdna3 registered), so the rebuild is skipped.
#   always — force the rebuild (a base whose wheel drifts, or a patched ref).
#   never  — trust the base image. The final verify step below still asserts
#            the op AND the code objects, so a wrong base fails the build.
ARG VLLM_REBUILD=auto

COPY build/scripts/verify_vllm_gfx1100_native_w4a16.py /opt/flexinfer/verify_vllm_gfx1100_native_w4a16.py
COPY build/scripts/reuse_vllm_rust_frontend.py /opt/flexinfer/reuse_vllm_rust_frontend.py

# Rebuild the same release against the image's pinned ROCm/PyTorch stack,
# constrained to ${GPU_ARCH}, only when the probe says the base lacks it. The
# Rust frontend shipped by the base image is reused so the step needs no Rust
# toolchain and rebuilds only the native C++/HIP extensions.
RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cache/pip \
    set -eu; \
    case "${VLLM_REBUILD}" in \
      always) rebuild=1 ;; \
      never) rebuild=0 ;; \
      auto) if GPU_ARCH="${GPU_ARCH}" python3 /opt/flexinfer/verify_vllm_gfx1100_native_w4a16.py --probe-base; then rebuild=0; else rebuild=1; fi ;; \
      *) echo "VLLM_REBUILD must be auto, always or never (got '${VLLM_REBUILD}')" >&2; exit 2 ;; \
    esac; \
    if [ "${rebuild}" = 1 ]; then \
      echo "rebuilding vLLM ${VLLM_REF} native extensions for ${GPU_ARCH}"; \
      apt-get update && apt-get install -y --no-install-recommends \
        build-essential ccache cmake git ninja-build python3-dev \
      && rm -rf /var/lib/apt/lists/* \
      && python3 -m pip install --no-cache-dir \
        "setuptools>=78.1.1,<80" "setuptools-rust>=1.9.0" "setuptools-scm>=8" \
        wheel "packaging>=26.2" "cmake>=3.26.1,<4" "jinja2>=3.1.6" \
      && git clone --depth 1 --branch "${VLLM_REF}" "${VLLM_REPO}" /tmp/vllm-src \
      && python3 /opt/flexinfer/reuse_vllm_rust_frontend.py /tmp/vllm-src \
      && cd /tmp/vllm-src \
      && export VLLM_TARGET_DEVICE=rocm \
         VLLM_VERSION_OVERRIDE="${VLLM_REF#v}" \
         PYTORCH_ROCM_ARCH="${GPU_ARCH}" \
         GPU_TARGETS="${GPU_ARCH}" \
         MAX_JOBS=4 \
         CMAKE_ARGS="-DGPU_TARGETS=${GPU_ARCH}" \
      && python3 -m pip wheel --no-build-isolation --no-deps . -w /tmp/vllm-wheel \
      && python3 -m pip install --no-deps --force-reinstall /tmp/vllm-wheel/vllm-*.whl \
      && rm -rf /tmp/vllm-src /tmp/vllm-wheel; \
    else \
      echo "base image ships vLLM with the ${GPU_ARCH} ROCm extension; skipping the from-source rebuild"; \
    fi

# vLLM 0.32 registers Qwen3_5ForCausalLM / Qwen3_5MoeForCausalLM itself, with
# IsHybrid, SupportsMRoPE and the mamba state helpers on
# Qwen3_5ForCausalLMBase. The text plugin (0.9.0) skips those registrations
# when the registry already has them (the services/flexinfer#66 duplicate-
# registration check) and keeps what the runtime still lacks: the consumer-ROCm
# FLA autotuner pruning (fla_autotuners=N in the boot log), the text-only MTP
# config contract, and the MTP head quantization policy
# (FLEXINFER_QWEN35_MTP_HEAD=plain|checkpoint). The same plugin still completes
# the registration on 0.23/0.26 images built from this Dockerfile's history.
# Shared helpers for FlexInfer's vLLM general plugins (ROCm FLA autotune
# pruning, composite-config label resolution, hybrid-state wiring). Every
# plugin below imports this at module scope, and the plugin installs use
# --no-deps, so it must be installed FIRST.
COPY build/vllm-plugin-common /opt/flexinfer/vllm-plugin-common
RUN python3 -m pip install --no-cache-dir --no-deps /opt/flexinfer/vllm-plugin-common \
    && python3 -c 'import flexinfer_vllm_common; assert flexinfer_vllm_common.FLA_OPS_PREFIXES'

COPY build/vllm-qwen35-text-plugin /opt/flexinfer/qwen35-text-plugin
RUN python3 -m pip install --no-cache-dir --no-deps /opt/flexinfer/qwen35-text-plugin \
    && python3 -c 'from importlib.metadata import entry_points; assert any(ep.name == "flexinfer_qwen35_text" for ep in entry_points(group="vllm.general_plugins"))'

# Register Qwen3.5 sequence-classification checkpoints (cross-encoder NLI /
# rerank) as vLLM POOLING models. Pre-wrapping with as_seq_cls_model means
# --runner auto resolves to pooling with no CLI flag and no backend change.
# The build-time assertion covers the whole contract: the entry point is
# discoverable, both architectures reach the registry, and they report as
# pooling models. No GPU needed.
COPY build/vllm-qwen35-seqcls-plugin /opt/flexinfer/qwen35-seqcls-plugin
RUN python3 -m pip install --no-cache-dir --no-deps /opt/flexinfer/qwen35-seqcls-plugin \
    && python3 -c 'from importlib.metadata import entry_points; assert any(ep.name == "flexinfer_qwen35_seqcls" for ep in entry_points(group="vllm.general_plugins"))'

# Full contract: source wrapper, compiled op + ${GPU_ARCH} code objects, and
# the text plugin's register() on this exact vLLM (the script was COPY'd above).
RUN GPU_ARCH="${GPU_ARCH}" python3 /opt/flexinfer/verify_vllm_gfx1100_native_w4a16.py

# The Model controller appends the normal vLLM backend flags. An explicit
# entrypoint avoids all legacy FlexInfer Qwen/Gemma source rewriting.
ENTRYPOINT ["vllm", "serve"]
