# Dedicated gfx1100 GPTQ canary runtime.
#
# vLLM 0.23 was the first upstream release with the native RDNA3 W4A16 HIP
# kernel; this image now tracks 0.26.0, the first release carrying the
# hybrid-GDN mamba-block-split clamp (upstream PR #47782) that the ngram
# speculative-decoding re-canary depends on — see services/flexinfer#66. Keep
# this image separate from the legacy 0.17 serving persona until
# full-checkpoint logit/coherence and throughput acceptance passes.
ARG BASE_IMAGE=vllm/vllm-openai-rocm:v0.26.0
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF=v0.26.0

FROM ${BASE_IMAGE}

ARG GPU_ARCH=gfx1100
ARG VLLM_REPO
ARG VLLM_REF

ENV GPU_VENDOR=amd \
    GPU_ARCH=${GPU_ARCH} \
    HSA_OVERRIDE_GFX_VERSION=11.0.0 \
    PYTORCH_ROCM_ARCH=${GPU_ARCH} \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    VLLM_ROCM_USE_AITER=0

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ccache cmake git ninja-build python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir \
      "setuptools>=74" setuptools-rust setuptools-scm wheel packaging

# The published v0.26 ROCm image carries the RDNA3 Python dispatcher but its
# generic wheel omits the compiled gfx1100 op. Rebuild the same release against
# the image's pinned ROCm/PyTorch stack, constrained to gfx1100. Reuse the Rust
# frontend already shipped by the base image so this layer only rebuilds the
# native C++/HIP extensions.
RUN git clone --depth 1 --branch "${VLLM_REF}" "${VLLM_REPO}" /tmp/vllm-src \
    && python3 -c 'import pathlib, shutil, vllm; installed = pathlib.Path(vllm.__file__).resolve().parent / "vllm-rs"; target = pathlib.Path("/tmp/vllm-src/vllm/vllm-rs"); assert installed.is_file(), f"base image is missing precompiled Rust frontend: {installed}"; shutil.copy2(installed, target); target.chmod(0o755); print(f"reusing precompiled Rust frontend: {installed}")'

RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cache/pip \
    cd /tmp/vllm-src \
    && export VLLM_TARGET_DEVICE=rocm \
       VLLM_VERSION_OVERRIDE=0.26.0 \
       PYTORCH_ROCM_ARCH="${GPU_ARCH}" \
       GPU_TARGETS="${GPU_ARCH}" \
       MAX_JOBS=4 \
       CMAKE_ARGS="-DGPU_TARGETS=${GPU_ARCH}" \
    && python3 -m pip wheel --no-build-isolation --no-deps . -w /tmp/vllm-wheel \
    && python3 -m pip install --no-deps --force-reinstall /tmp/vllm-wheel/vllm-*.whl \
    && rm -rf /tmp/vllm-src /tmp/vllm-wheel

# vLLM 0.26 still ships Qwen3.5's text class while registering only the
# multimodal wrapper (upstream registration lands after this release, so the
# next bump must re-check for duplicate registration — services/flexinfer#66).
# Install FlexInfer's existing general plugin so the extracted
# Qwen3_5TextConfig artifact resolves to Qwen3_5ForCausalLM in both the API and
# EngineCore processes instead of falling through to a vision_config access.
COPY build/vllm-qwen35-text-plugin /opt/flexinfer/qwen35-text-plugin
RUN python3 -m pip install --no-cache-dir --no-deps /opt/flexinfer/qwen35-text-plugin \
    && python3 -c 'from importlib.metadata import entry_points; assert any(ep.name == "flexinfer_qwen35_text" for ep in entry_points(group="vllm.general_plugins"))'

COPY build/scripts/verify_vllm_gfx1100_native_w4a16.py /opt/flexinfer/verify_vllm_gfx1100_native_w4a16.py

RUN python3 /opt/flexinfer/verify_vllm_gfx1100_native_w4a16.py

# The Model controller appends the normal vLLM backend flags. An explicit
# entrypoint avoids all legacy FlexInfer Qwen/Gemma source rewriting.
ENTRYPOINT ["vllm", "serve"]
