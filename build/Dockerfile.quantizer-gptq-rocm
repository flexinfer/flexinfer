# Dockerfile.quantizer-gptq-rocm
# GPTQ quantization runtime image for FlexInfer on AMD ROCm GPUs.
# Uses GPTQModel (actively maintained successor to auto-gptq) which has
# native ROCm/HIP support via auto-detected pip install.
#
# Build:
#   docker --context 7900xtx build -f build/Dockerfile.quantizer-gptq-rocm \
#     -t registry.harbor.lan/flexinfer/quantizer:gptq-rocm-gfx1100 .
#
# The resulting image is ~12 GB (ROCm base + PyTorch + GPTQModel).

FROM rocm/pytorch:rocm6.4.1_ubuntu22.04_py3.10_pytorch_release_2.6.0

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTORCH_ROCM_ARCH=gfx1100

RUN python3 -m pip install --upgrade pip setuptools wheel

# The ROCm PyTorch base image ships a broken editable Triton install
# (/var/lib/jenkins/triton/python) that lacks the jit API. Replace it
# with the PyPI wheel which includes full ROCm/HIP support.
RUN python3 -m pip install --force-reinstall triton==3.2.0

# GPTQModel v6.0.3+ has native Gemma4 MoE support — quantizes experts natively
# instead of excluding them (fused 3D tensors handled by new MoE lifecycle hooks).
# CRITICAL: Use --no-deps to prevent gptqmodel from pulling CUDA torch>=2.8.0
# from PyPI, which would overwrite the ROCm PyTorch 2.6.0 from the base image.
# On ROCm, ext_modules=[] (no native extensions), so the build is pure Python.
# Pre-install pypcre: GPTQModel 6.0.3's setup.py imports pcre at metadata time.
RUN python3 -m pip install pypcre && \
    python3 -m pip install -v "gptqmodel>=6.0.3" \
    --no-build-isolation --no-deps

# Install gptqmodel's runtime dependencies separately, keeping ROCm torch intact.
# GPTQModel 5.7.0 requires transformers>=4.57.1 (handles Qwen3 attention_type API).
# Qwen3.5 model_type support requires transformers>=5.0.
RUN python3 -m pip install \
    "transformers>=5.0" \
    safetensors \
    accelerate \
    datasets \
    sentencepiece \
    huggingface_hub \
    protobuf \
    pillow \
    hf_transfer \
    device-smi \
    tokenicer \
    logbar \
    maturin \
    pyarrow \
    dill \
    pypcre \
    zstandard \
    defuser

# Fix numpy ABI mismatch. Base image has numpy 1.22.4, pandas 1.5.x, scipy 1.10.x,
# numba 0.55.2. Modern pyarrow/datasets pull newer scipy/sklearn compiled against
# newer numpy, causing ABI crashes. Constraints:
#   - numpy 2.x breaks PyTorch 2.6 ROCm build (tensor.numpy() -> "Numpy is not available")
#   - numpy 1.26.x + numba 0.55.2 (expects <1.23) causes segfaults
# Solution: uninstall numba (not needed for GPTQ), upgrade numpy to 1.26.x,
# and force-reinstall pandas/scipy/sklearn compiled against numpy 1.26.
RUN python3 -m pip uninstall -y numba llvmlite && \
    python3 -m pip install --force-reinstall \
    "numpy>=1.26,<2" \
    pandas \
    scipy \
    scikit-learn

# FlexInfer quantization and abliteration scripts (referenced by controller wrapper)
COPY build/scripts/quantize_gptq.py /opt/flexinfer/scripts/quantize_gptq.py
COPY build/scripts/qwen35_wrap_to_vl_layout.py /opt/flexinfer/scripts/qwen35_wrap_to_vl_layout.py
COPY build/scripts/qwen35_unwrap_from_vl_layout.py /opt/flexinfer/scripts/qwen35_unwrap_from_vl_layout.py
RUN mkdir -p /app && printf 'FLEXINFER_SCRIPT_VERSION = "v21"\n' > /app/quantize_gptq.py
COPY build/scripts/abliterate.py /opt/flexinfer/scripts/abliterate.py
COPY build/scripts/abliterate_safety.py /opt/flexinfer/scripts/abliterate_safety.py
RUN printf 'FLEXINFER_SCRIPT_VERSION = "v1"\n' > /app/abliterate.py

# The controller probes /workspace/quantize_gptq.py before anything else, but the
# pod mounts /workspace as an emptyDir. Seed that mount before the wrapper runs.
RUN mv /bin/bash /bin/bash.real && \
    printf '%s\n' \
      '#!/bin/sh' \
      'mkdir -p /workspace' \
      'if [ ! -f /workspace/quantize_gptq.py ]; then' \
      '  printf '\''FLEXINFER_SCRIPT_VERSION = "v21"\n'\'' > /workspace/quantize_gptq.py' \
      'fi' \
      'if [ ! -f /workspace/abliterate.py ]; then' \
      '  printf '\''FLEXINFER_SCRIPT_VERSION = "v1"\n'\'' > /workspace/abliterate.py' \
      'fi' \
      'exec /bin/bash.real "$@"' \
      > /bin/bash && \
    chmod +x /bin/bash

ENTRYPOINT ["/bin/bash"]
