# Dockerfile.quantizer-gptq
# GPTQ quantization runtime image for FlexInfer ModelCache quantization jobs.
# Uses CUDA userspace + GPTQModel (actively maintained successor to auto-gptq).

FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel

# Pin to known-compatible CUDA 12.1 wheels for stability in CI/build environments.
RUN python3 -m pip install \
    --index-url https://download.pytorch.org/whl/cu121 \
    torch==2.3.1 torchvision==0.18.1

# GPTQModel auto-detects CUDA and builds kernels via --no-build-isolation.
# Pin transformers to 4.51.3 for stability.
RUN python3 -m pip install -v gptqmodel --no-build-isolation && \
    python3 -m pip install \
    transformers==4.51.3 \
    accelerate \
    safetensors \
    datasets \
    sentencepiece \
    huggingface_hub

ENTRYPOINT ["/bin/bash"]
