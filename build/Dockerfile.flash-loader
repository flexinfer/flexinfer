# Flash-Loader init container image
# Parallel-copies model files from PVC to tmpfs for fast cold starts.
FROM golang:1.26-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /flash-loader ./cmd/flexinfer-flash-loader

FROM alpine:3.23

COPY --from=builder /flash-loader /usr/local/bin/flash-loader

ENTRYPOINT ["/usr/local/bin/flash-loader"]
