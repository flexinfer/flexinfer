# vLLM-Omni Docker image for AMD GPUs (ROCm)
# Optimized for RX 7900 XTX (gfx1100) - consumer RDNA3 GPUs
#
# Build command:
#   docker build --build-arg BUILD_FA=0 -f build/Dockerfile.vllm-omni-rocm -t vllm-omni-rocm .
#
# Note: BUILD_FA=0 disables flash-attention which is not supported on gfx1100

ARG ROCM_VERSION=6.2
FROM rocm/pytorch:rocm${ROCM_VERSION}_ubuntu22.04_py3.10_pytorch_release_2.3.0

# Build arguments
ARG BUILD_FA=0
ARG PYTORCH_ROCM_ARCH=gfx1100
ARG MAX_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ROCm environment for RX 7900 XTX
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH}
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV HIP_VISIBLE_DEVICES=0
ENV ROCR_VISIBLE_DEVICES=0
ENV VLLM_TARGET_DEVICE=rocm
ENV MAX_JOBS=${MAX_JOBS}

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    cmake \
    ninja-build \
    ccache \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Clone vLLM - using main branch for latest diffusion support
RUN git clone --depth 1 https://github.com/vllm-project/vllm.git /workspace/vllm

WORKDIR /workspace/vllm

# Install build requirements
RUN pip install --no-cache-dir -r requirements-rocm.txt 2>/dev/null || \
    pip install --no-cache-dir cmake ninja packaging wheel

# Install core dependencies
# Note: xformers is CUDA-only, skip for ROCm. Triton ROCm builds may need special handling.
RUN pip install --no-cache-dir \
    "numpy<2" \
    transformers \
    accelerate \
    safetensors \
    && (pip install --no-cache-dir triton 2>/dev/null || echo "Triton install skipped for ROCm")

# Constrain torch to existing ROCm version to prevent pip from replacing it
# The base image has ROCm torch 2.3.0, we need to keep it
RUN pip freeze | grep -i torch > /tmp/torch-constraints.txt && \
    echo "torch" >> /tmp/torch-constraints.txt && \
    cat /tmp/torch-constraints.txt

# Build and install vLLM
# BUILD_FA=0 disables flash-attention for gfx1100
# Use --no-build-isolation to use system torch
ENV BUILD_FA=${BUILD_FA}
ENV PIP_CONSTRAINT=/tmp/torch-constraints.txt
RUN pip install --no-cache-dir --no-build-isolation -v -e . || \
    (echo "Build failed, trying with constraints..." && \
     pip install --no-cache-dir -v -e . --constraint /tmp/torch-constraints.txt)

# Install diffusion/image generation dependencies
RUN pip install --no-cache-dir \
    diffusers>=0.30.0 \
    pillow \
    sentencepiece \
    protobuf

# Force numpy < 2 for ROCm compatibility (do this last)
RUN pip install --no-cache-dir --force-reinstall "numpy<2"

# Verify installation
RUN python -c "import vllm; print(f'vLLM version: {vllm.__version__}')"

# Create model directory
RUN mkdir -p /models

WORKDIR /workspace

# Expose vLLM API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default entrypoint for vLLM OpenAI-compatible server
ENTRYPOINT ["python", "-m", "vllm.entrypoints.openai.api_server"]

# Default arguments (can be overridden)
CMD ["--host", "0.0.0.0", "--port", "8000"]
