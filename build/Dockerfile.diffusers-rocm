# Diffusers API Server for AMD GPUs (ROCm)
# Provides OpenAI-compatible /v1/images/generations and /v1/images/edits endpoints
# Optimized for RX 7900 XTX (gfx1100)
#
# Based on research from:
# - https://llm-tracker.info/howto/AMD-GPUs
# - https://rocm.docs.amd.com/projects/install-on-linux/en/latest/install/3rd-party/pytorch-install.html
# - https://community.frame.work/t/stable-diffusion-rocm-pytorch-setup/53802
# - https://github.com/ROCm/ROCm/issues/4729 (VAE decode crashes)
# - https://huggingface.co/madebyollin/sdxl-vae-fp16-fix (fixed VAE)

# Use official ROCm PyTorch image with gfx1100 support
# Pin to a specific tag for reproducible builds (matches ComfyUI Dockerfile)
# Supported architectures include gfx1100/gfx1101 (Navi31-based SKUs like 7900 XTX)
# See: https://hub.docker.com/r/rocm/pytorch
ARG ROCM_PYTORCH_TAG=rocm6.2.3_ubuntu22.04_py3.10_pytorch_release_2.3.0
FROM rocm/pytorch:${ROCM_PYTORCH_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Force offline mode - don't try to reach HuggingFace when loading local models
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1

# ROCm environment for RX 7900 XTX (gfx1100 / RDNA3)
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV PYTORCH_ROCM_ARCH=gfx1100
# Note: HIP_VISIBLE_DEVICES defaults to all visible devices (device 0 when
# a single GPU is allocated to the container by the Kubernetes device plugin).

# Critical for gfx1100 stability - enables experimental AOTriton flash attention
ENV TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1

# Disable xformers which can cause SIGSEGV on ROCm
ENV XFORMERS_DISABLED=1

# Force synchronous GPU operations for stability during model loading
ENV HIP_LAUNCH_BLOCKING=0
ENV AMD_SERIALIZE_KERNEL=0
ENV AMD_SERIALIZE_COPY=0

# CRITICAL: Fix VAE decode crashes on gfx1100 (ROCm issue #4729)
# MIOPEN_FIND_MODE=2 disables problematic kernel-finding that causes driver timeouts
# This is the key fix for SDXL VAE decode crashes on 7900 XTX
ENV MIOPEN_FIND_MODE=2

# Prefer ROCm BLAS over hipBLASLt which has stability issues on gfx1100
ENV TORCH_BLAS_PREFER_HIPBLASLT=0

# Memory allocation settings to prevent fragmentation
# Higher GC threshold (0.9) reduces memory pressure during VAE operations
ENV PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.9,max_split_size_mb:512

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pinned Python dependencies
COPY build/requirements-diffusers-rocm.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Force numpy < 2 for ROCm compatibility (overrides any transitive upgrade)
RUN pip install --no-cache-dir --force-reinstall "numpy<2"

# Create the API server
COPY <<'EOF' /app/server.py
"""
Diffusers API Server with OpenAI-compatible /v1/images/generations and /v1/images/edits endpoints.
ROCm-compatible version for AMD GPUs (gfx1100 / RX 7900 XTX).
Supports text2image, inpainting, and InstructPix2Pix modes via PIPELINE_MODE env var.
