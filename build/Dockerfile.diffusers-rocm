# Diffusers API Server for AMD GPUs (ROCm)
# Provides OpenAI-compatible /v1/images/generations endpoint
# Optimized for RX 7900 XTX (gfx1100)

FROM rocm/pytorch:rocm6.2.3_ubuntu22.04_py3.10_pytorch_release_2.3.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ROCm environment for RX 7900 XTX
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV PYTORCH_ROCM_ARCH=gfx1100
ENV HIP_VISIBLE_DEVICES=0
ENV ROCR_VISIBLE_DEVICES=0

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    diffusers>=0.30.0 \
    transformers \
    accelerate \
    safetensors \
    pillow \
    pydantic \
    python-multipart \
    aiofiles

# Force numpy < 2 for ROCm compatibility
RUN pip install --no-cache-dir --force-reinstall "numpy<2"

# Create the API server
COPY <<'EOF' /app/server.py
"""
Diffusers API Server with OpenAI-compatible /v1/images/generations endpoint.
ROCm-compatible version for AMD GPUs (gfx1100 / RX 7900 XTX).
"""
import os
import io
import base64
import uuid
import time
import sys
from typing import Optional, List
from contextlib import asynccontextmanager

import torch
from PIL import Image
from fastapi import FastAPI, HTTPException
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field
from diffusers import AutoPipelineForText2Image, DiffusionPipeline

# Global pipeline cache
pipeline = None
current_model = None
gpu_info = None

def check_gpu():
    """Check GPU availability and print diagnostics."""
    global gpu_info
    print("=" * 60)
    print("GPU Diagnostics")
    print("=" * 60)
    print(f"PyTorch version: {torch.__version__}")
    print(f"CUDA available: {torch.cuda.is_available()}")
    if torch.cuda.is_available():
        print(f"CUDA device count: {torch.cuda.device_count()}")
        for i in range(torch.cuda.device_count()):
            props = torch.cuda.get_device_properties(i)
            print(f"  Device {i}: {props.name}")
            print(f"    Total memory: {props.total_memory / 1024**3:.1f} GB")
        gpu_info = torch.cuda.get_device_properties(0).name
    else:
        print("WARNING: No CUDA/ROCm GPU detected!")
        gpu_info = "CPU only"
    print("=" * 60)
    sys.stdout.flush()

class ImageGenerationRequest(BaseModel):
    prompt: str
    model: Optional[str] = None
    n: int = Field(default=1, ge=1, le=10)
    size: str = "1024x1024"
    quality: str = "standard"
    response_format: str = "b64_json"  # or "url"
    style: Optional[str] = None
    negative_prompt: Optional[str] = None
    num_inference_steps: int = Field(default=20, ge=1, le=100)
    guidance_scale: float = Field(default=7.5, ge=1.0, le=20.0)

class ImageData(BaseModel):
    b64_json: Optional[str] = None
    url: Optional[str] = None
    revised_prompt: Optional[str] = None

class ImageGenerationResponse(BaseModel):
    created: int
    data: List[ImageData]

def load_pipeline(model_id: str):
    """Load or reload the diffusion pipeline."""
    global pipeline, current_model

    if pipeline is not None and current_model == model_id:
        return pipeline

    print(f"Loading model: {model_id}")
    sys.stdout.flush()

    # Determine dtype - use fp32 for ROCm stability, fp16 optional
    use_fp16 = os.environ.get("USE_FP16", "0") == "1"
    dtype = torch.float16 if use_fp16 else torch.float32
    print(f"Using dtype: {dtype}")

    # Try AutoPipeline first, fall back to DiffusionPipeline
    try:
        print("Attempting AutoPipelineForText2Image...")
        pipeline = AutoPipelineForText2Image.from_pretrained(
            model_id,
            torch_dtype=dtype,
            use_safetensors=True,
        )
    except Exception as e:
        print(f"AutoPipeline failed: {e}, trying DiffusionPipeline...")
        pipeline = DiffusionPipeline.from_pretrained(
            model_id,
            torch_dtype=dtype,
            use_safetensors=True,
        )

    print("Moving model to GPU...")
    sys.stdout.flush()

    # Move to GPU with error handling
    try:
        pipeline = pipeline.to("cuda")
    except Exception as e:
        print(f"ERROR moving to GPU: {e}")
        print("Falling back to CPU...")
        pipeline = pipeline.to("cpu")

    # Enable memory optimizations (safe for ROCm)
    try:
        if hasattr(pipeline, 'enable_attention_slicing'):
            pipeline.enable_attention_slicing()
            print("Enabled attention slicing")
    except Exception as e:
        print(f"Could not enable attention slicing: {e}")

    current_model = model_id
    print(f"Model loaded: {model_id}")
    sys.stdout.flush()
    return pipeline

@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup: check GPU and preload model if specified
    check_gpu()
    model_id = os.environ.get("MODEL_ID", os.environ.get("MODEL", ""))
    if model_id:
        load_pipeline(model_id)
    yield
    # Shutdown
    global pipeline
    pipeline = None

app = FastAPI(title="Diffusers API", lifespan=lifespan)

@app.get("/health")
async def health():
    return {"status": "healthy", "model": current_model, "gpu": gpu_info}

@app.get("/v1/models")
async def list_models():
    models = []
    if current_model:
        models.append({
            "id": current_model,
            "object": "model",
            "created": int(time.time()),
            "owned_by": "diffusers"
        })
    return {"object": "list", "data": models}

@app.post("/v1/images/generations")
async def generate_images(request: ImageGenerationRequest):
    global pipeline

    model_id = request.model or os.environ.get("MODEL_ID") or os.environ.get("MODEL")
    if not model_id:
        raise HTTPException(status_code=400, detail="No model specified")

    # Load pipeline if needed
    pipe = load_pipeline(model_id)

    # Parse size
    try:
        width, height = map(int, request.size.split("x"))
    except ValueError:
        width, height = 1024, 1024

    # Generate images
    images = []
    for _ in range(request.n):
        result = pipe(
            prompt=request.prompt,
            negative_prompt=request.negative_prompt,
            num_inference_steps=request.num_inference_steps,
            guidance_scale=request.guidance_scale,
            width=width,
            height=height,
        )

        img = result.images[0]

        # Convert to base64
        buffer = io.BytesIO()
        img.save(buffer, format="PNG")
        b64_data = base64.b64encode(buffer.getvalue()).decode("utf-8")

        images.append(ImageData(b64_json=b64_data))

    return ImageGenerationResponse(
        created=int(time.time()),
        data=images
    )

if __name__ == "__main__":
    import uvicorn
    port = int(os.environ.get("PORT", 8000))
    uvicorn.run(app, host="0.0.0.0", port=port)
EOF

# Create model directory
RUN mkdir -p /models

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the server
CMD ["python", "/app/server.py"]
