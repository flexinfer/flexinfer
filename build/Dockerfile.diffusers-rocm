# Diffusers API Server for AMD GPUs (ROCm)
# Provides OpenAI-compatible /v1/images/generations endpoint
# Optimized for RX 7900 XTX (gfx1100)
#
# Based on research from:
# - https://llm-tracker.info/howto/AMD-GPUs
# - https://rocm.docs.amd.com/projects/install-on-linux/en/latest/install/3rd-party/pytorch-install.html
# - https://community.frame.work/t/stable-diffusion-rocm-pytorch-setup/53802

# Use official ROCm PyTorch image with gfx1100 support
# The 'latest' tag includes the most recent stable PyTorch + ROCm combination
# Supported architectures include gfx1100/gfx1101 (Navi31-based SKUs like 7900 XTX)
# See: https://hub.docker.com/r/rocm/pytorch
ARG ROCM_PYTORCH_TAG=latest
FROM rocm/pytorch:${ROCM_PYTORCH_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ROCm environment for RX 7900 XTX (gfx1100 / RDNA3)
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV PYTORCH_ROCM_ARCH=gfx1100
# Note: HIP_VISIBLE_DEVICES defaults to all visible devices (device 0 when
# a single GPU is allocated to the container by the Kubernetes device plugin).

# Critical for gfx1100 stability - enables experimental AOTriton flash attention
ENV TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1

# Disable xformers which can cause SIGSEGV on ROCm
ENV XFORMERS_DISABLED=1

# Force synchronous GPU operations for stability during model loading
ENV HIP_LAUNCH_BLOCKING=0
ENV AMD_SERIALIZE_KERNEL=0
ENV AMD_SERIALIZE_COPY=0

# CRITICAL: Fix VAE decode crashes on gfx1100 (ROCm issue #4729)
# MIOPEN_FIND_MODE=2 disables problematic kernel-finding that causes driver timeouts
# This is the key fix for SDXL VAE decode crashes on 7900 XTX
ENV MIOPEN_FIND_MODE=2

# Prefer ROCm BLAS over hipBLASLt which has stability issues on gfx1100
ENV TORCH_BLAS_PREFER_HIPBLASLT=0

# Memory allocation settings to prevent fragmentation
# Higher GC threshold (0.9) reduces memory pressure during VAE operations
ENV PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.9,max_split_size_mb:512

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    diffusers>=0.30.0 \
    transformers \
    accelerate \
    safetensors \
    pillow \
    pydantic \
    python-multipart \
    aiofiles

# Force numpy < 2 for ROCm compatibility
RUN pip install --no-cache-dir --force-reinstall "numpy<2"

# Create the API server
COPY <<'EOF' /app/server.py
"""
Diffusers API Server with OpenAI-compatible /v1/images/generations endpoint.
ROCm-compatible version for AMD GPUs (gfx1100 / RX 7900 XTX).
"""
import os
import io
import base64
import uuid
import time
import sys
from typing import Optional, List
from contextlib import asynccontextmanager

import torch
from PIL import Image
from fastapi import FastAPI, HTTPException
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field
from diffusers import AutoPipelineForText2Image, DiffusionPipeline

# Global pipeline cache
pipeline = None
current_model = None
gpu_info = None

def check_gpu():
    """Check GPU availability and print diagnostics."""
    global gpu_info
    print("=" * 60)
    print("GPU Diagnostics (ROCm/HIP)")
    print("=" * 60)
    print(f"PyTorch version: {torch.__version__}")

    # Check for ROCm/HIP version
    hip_version = getattr(torch.version, 'hip', None)
    cuda_version = getattr(torch.version, 'cuda', None)
    print(f"HIP version: {hip_version}")
    print(f"CUDA version: {cuda_version}")

    # Environment variables
    print(f"HSA_OVERRIDE_GFX_VERSION: {os.environ.get('HSA_OVERRIDE_GFX_VERSION', 'not set')}")
    print(f"PYTORCH_ROCM_ARCH: {os.environ.get('PYTORCH_ROCM_ARCH', 'not set')}")
    print(f"TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL: {os.environ.get('TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL', 'not set')}")

    print(f"CUDA/ROCm available: {torch.cuda.is_available()}")
    if torch.cuda.is_available():
        print(f"Device count: {torch.cuda.device_count()}")
        for i in range(torch.cuda.device_count()):
            props = torch.cuda.get_device_properties(i)
            print(f"  Device {i}: {props.name}")
            print(f"    Total memory: {props.total_memory / 1024**3:.1f} GB")
            print(f"    Architecture: gfx{props.major}{props.minor}0" if hasattr(props, 'major') else "    Architecture: unknown")
        gpu_info = torch.cuda.get_device_properties(0).name

        # Skip basic tensor test - torch.randn on ROCm gfx1100 can cause SIGSEGV
        # GPU functionality will be verified during model loading
        print("  GPU detected, will verify during model load")
    else:
        print("WARNING: No CUDA/ROCm GPU detected!")
        gpu_info = "CPU only"
    print("=" * 60)
    sys.stdout.flush()

class ImageGenerationRequest(BaseModel):
    prompt: str
    model: Optional[str] = None
    n: int = Field(default=1, ge=1, le=10)
    size: str = "1024x1024"
    quality: str = "standard"
    response_format: str = "b64_json"  # or "url"
    style: Optional[str] = None
    negative_prompt: Optional[str] = None
    num_inference_steps: int = Field(default=20, ge=1, le=100)
    guidance_scale: float = Field(default=7.5, ge=1.0, le=20.0)

class ImageData(BaseModel):
    b64_json: Optional[str] = None
    url: Optional[str] = None
    revised_prompt: Optional[str] = None

class ImageGenerationResponse(BaseModel):
    created: int
    data: List[ImageData]

def load_pipeline(model_id: str):
    """Load or reload the diffusion pipeline."""
    global pipeline, current_model

    if pipeline is not None and current_model == model_id:
        return pipeline

    print(f"Loading model: {model_id}")
    sys.stdout.flush()

    # Force fp32 for ROCm stability (gfx1100 has fp16 issues with some ops)
    # Only use fp16 if explicitly requested AND tested
    use_fp16 = os.environ.get("USE_FP16", "0") == "1"
    dtype = torch.float16 if use_fp16 else torch.float32
    print(f"Using dtype: {dtype}")
    print(f"USE_FP16 env: {os.environ.get('USE_FP16', 'not set')}")

    # Clear GPU cache before loading
    if torch.cuda.is_available():
        torch.cuda.empty_cache()
        torch.cuda.synchronize()
        print(f"GPU memory before load: {torch.cuda.memory_allocated() / 1024**3:.2f} GB")

    # Try AutoPipeline first, fall back to DiffusionPipeline
    try:
        print("Attempting AutoPipelineForText2Image...")
        sys.stdout.flush()
        pipeline = AutoPipelineForText2Image.from_pretrained(
            model_id,
            torch_dtype=dtype,
            use_safetensors=True,
            # Disable safety checker to save memory
            safety_checker=None,
            requires_safety_checker=False,
        )
    except Exception as e:
        print(f"AutoPipeline failed: {e}, trying DiffusionPipeline...")
        sys.stdout.flush()
        pipeline = DiffusionPipeline.from_pretrained(
            model_id,
            torch_dtype=dtype,
            use_safetensors=True,
            safety_checker=None,
        )

    print("Pipeline loaded to CPU, preparing GPU transfer...")
    sys.stdout.flush()

    # Move to GPU with explicit synchronization
    try:
        print("Moving model to GPU (this may take a moment)...")
        sys.stdout.flush()

        # Move component by component for better error isolation
        pipeline = pipeline.to("cuda")

        # Synchronize to catch any async errors
        torch.cuda.synchronize()

        print(f"GPU memory after load: {torch.cuda.memory_allocated() / 1024**3:.2f} GB")
    except Exception as e:
        print(f"ERROR moving to GPU: {e}")
        print(f"Exception type: {type(e).__name__}")
        import traceback
        traceback.print_exc()
        print("Falling back to CPU...")
        sys.stdout.flush()
        pipeline = pipeline.to("cpu")

    # Enable memory optimizations (safe for ROCm)
    # Note: Attention slicing is safer than xformers on ROCm
    try:
        if hasattr(pipeline, 'enable_attention_slicing'):
            pipeline.enable_attention_slicing("max")
            print("Enabled attention slicing (max)")
    except Exception as e:
        print(f"Could not enable attention slicing: {e}")

    # VAE slicing helps with memory on large images
    try:
        if hasattr(pipeline, 'enable_vae_slicing'):
            pipeline.enable_vae_slicing()
            print("Enabled VAE slicing")
    except Exception as e:
        print(f"Could not enable VAE slicing: {e}")

    current_model = model_id
    print(f"Model loaded successfully: {model_id}")
    sys.stdout.flush()
    return pipeline

@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup: check GPU and preload model if specified
    check_gpu()
    model_id = os.environ.get("MODEL_ID", os.environ.get("MODEL", ""))
    if model_id:
        load_pipeline(model_id)
    yield
    # Shutdown
    global pipeline
    pipeline = None

app = FastAPI(title="Diffusers API", lifespan=lifespan)

@app.get("/health")
async def health():
    return {"status": "healthy", "model": current_model, "gpu": gpu_info}

@app.get("/v1/models")
async def list_models():
    models = []
    if current_model:
        models.append({
            "id": current_model,
            "object": "model",
            "created": int(time.time()),
            "owned_by": "diffusers"
        })
    return {"object": "list", "data": models}

@app.post("/v1/images/generations")
async def generate_images(request: ImageGenerationRequest):
    global pipeline

    # Prioritize environment variable (set by FlexInfer ModelDeployment) over request model
    # request.model may be an alias like "image-gen" rather than the actual HuggingFace model ID
    model_id = os.environ.get("MODEL_ID") or os.environ.get("MODEL") or request.model
    if not model_id:
        raise HTTPException(status_code=400, detail="No model specified")

    # Load pipeline if needed
    pipe = load_pipeline(model_id)

    # Parse size
    try:
        width, height = map(int, request.size.split("x"))
    except ValueError:
        width, height = 1024, 1024

    # Generate images
    images = []
    for _ in range(request.n):
        result = pipe(
            prompt=request.prompt,
            negative_prompt=request.negative_prompt,
            num_inference_steps=request.num_inference_steps,
            guidance_scale=request.guidance_scale,
            width=width,
            height=height,
        )

        img = result.images[0]

        # Convert to base64
        buffer = io.BytesIO()
        img.save(buffer, format="PNG")
        b64_data = base64.b64encode(buffer.getvalue()).decode("utf-8")

        images.append(ImageData(b64_json=b64_data))

    return ImageGenerationResponse(
        created=int(time.time()),
        data=images
    )

if __name__ == "__main__":
    import uvicorn
    port = int(os.environ.get("PORT", 8000))
    uvicorn.run(app, host="0.0.0.0", port=port)
EOF

# Create model directory
RUN mkdir -p /models

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the server
CMD ["python", "/app/server.py"]
