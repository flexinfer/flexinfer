# vLLM Docker image for AMD GPUs (ROCm)
# Uses official ROCm vLLM image with gfx1100 (RX 7900 XTX) support via HSA_OVERRIDE
#
# Build command:
#   docker build -f build/Dockerfile.vllm-rocm -t vllm-rocm .
#
# Note: Official rocm/vllm images are built for MI300, but work on gfx1100 with
# HSA_OVERRIDE_GFX_VERSION=11.0.0 environment variable

# Use official ROCm vLLM image with ROCm 6.4.1 (matches our host ROCm version)
FROM rocm/vllm:rocm6.4.1_vllm_0.10.1_20250909

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ROCm environment for RX 7900 XTX (gfx1100)
# HSA_OVERRIDE_GFX_VERSION tricks ROCm into treating gfx1100 as supported
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV PYTORCH_ROCM_ARCH=gfx1100
ENV HIP_VISIBLE_DEVICES=0
ENV ROCR_VISIBLE_DEVICES=0

# Critical for gfx1100 stability - enables experimental AOTriton flash attention
ENV TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1

WORKDIR /workspace

# vLLM is pre-installed in the base image, just add extra dependencies
RUN pip install --no-cache-dir \
    diffusers>=0.30.0 \
    pillow \
    sentencepiece \
    protobuf \
    "numpy<2"

# Create model directory
RUN mkdir -p /models

# Expose vLLM API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default entrypoint for vLLM OpenAI-compatible server
ENTRYPOINT ["python", "-m", "vllm.entrypoints.openai.api_server"]

# Default arguments (can be overridden)
CMD ["--host", "0.0.0.0", "--port", "8000"]
