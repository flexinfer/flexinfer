# Pyannote speaker-diarization-3.1 on gfx906 (Radeon VII) — ASR/diarization Slice 4.
#
# Base: mixa3607/pytorch-gfx906 — community PyTorch fork that restores GPU
# compute on Vega20 (upstream PyTorch dropped gfx906 in 2.4+). Already the
# validated gfx906 baseline for flexinfer's abliteration/quantization images.
#
# pyannote 3.1 is PyTorch-only (no custom CUDA/HIP kernels): segmentation-3.0
# is a torch model, the speaker embedding (wespeaker-…-LM) runs via ONNX
# Runtime. Both should dispatch on the fork's HIP torch without recompilation —
# that is exactly the kill-test's load-bearing assumption.
#
# Two entrypoints baked in:
#   - pyannote_diarize_probe.py : one-shot CLI kill-test (run a WAV, print RTTM)
#   - pyannote_server.py        : FastAPI /diarize service (Slice 4 production)
FROM mixa3607/pytorch-gfx906:v2.9.0-rocm-6.3.3

ENV DEBIAN_FRONTEND=noninteractive \
    HSA_OVERRIDE_GFX_VERSION=9.0.6 \
    HF_HUB_DISABLE_XET=1 \
    PYTHONUNBUFFERED=1

# ffmpeg/libsndfile for audio I/O (torchaudio/soundfile backends).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libsndfile1 curl \
    && rm -rf /var/lib/apt/lists/*

# Pin the fork's torch/torchaudio via a constraints file so installing
# pyannote.audio cannot pull a PyPI (CUDA) torch over the HIP fork. The fork's
# version string carries a +rocm local tag, making the constraint exact.
RUN python -c "import torch,torchaudio; \
print('torch==%s' % torch.__version__); \
print('torchaudio==%s' % torchaudio.__version__)" > /tmp/torch-constraints.txt \
    && cat /tmp/torch-constraints.txt

# numpy 1.26.x: pyannote + the gfx906 stack both require numpy 1.x.
# onnxruntime: the speaker-embedding model is ONNX. soundfile: WAV I/O.
#
# pyannote.audio 3.3.2 (not 3.1.1): 3.1.x calls the deprecated
# torchaudio.set_audio_backend(), REMOVED in torchaudio 2.2+. The gfx906 fork
# ships torchaudio 2.9, so 3.1.1 fails at import. 3.3.x uses the torchaudio
# dispatcher backend and is compatible. The pipeline weights
# (speaker-diarization-3.1) load identically under 3.3.x.
# huggingface_hub pinned < 1.0: pyannote 3.3.2 calls hf_hub_download(use_auth_token=...),
# an argument huggingface_hub 1.x removed. 0.25.2 still supports it.
RUN PIP_CONSTRAINT=/tmp/torch-constraints.txt pip install --no-cache-dir \
        "numpy==1.26.4" \
        "huggingface_hub==0.25.2" \
        "pyannote.audio==3.3.2" \
        "onnxruntime==1.17.3" \
        "soundfile==0.12.1" \
        "fastapi==0.110.0" \
        "uvicorn[standard]==0.29.0" \
        "python-multipart==0.0.9"

# torchaudio_compat re-adds the symbols pyannote references at import time
# (torchaudio.AudioMetaData + set_audio_backend) that the fork's torchaudio 2.9
# removed. The scripts import it before pyannote.
COPY build/scripts/torchaudio_compat.py /app/torchaudio_compat.py
COPY build/scripts/pyannote_diarize_probe.py /app/pyannote_diarize_probe.py
COPY build/scripts/pyannote_server.py /app/pyannote_server.py
WORKDIR /app

# Build-time gate: importing torchaudio_compat THEN pyannote must succeed — a
# green build proves the whole import chain works on the fork's torchaudio 2.9.
RUN python -c "import torchaudio_compat, torch, torchaudio, pyannote.audio, onnxruntime, soundfile; \
print('torch', torch.__version__, '| torchaudio', torchaudio.__version__, \
'| pyannote', pyannote.audio.__version__, '| AudioMetaData', torchaudio.AudioMetaData)"

# Default to the FastAPI service; the kill-test overrides command to run the probe.
EXPOSE 8000
CMD ["uvicorn", "pyannote_server:app", "--host", "0.0.0.0", "--port", "8000"]
