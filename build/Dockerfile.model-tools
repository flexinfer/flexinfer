# Dockerfile.model-tools
# Lightweight CPU-only helper image for ModelCache publish and validation jobs.

FROM ghcr.io/oras-project/oras:v1.2.2@sha256:cd549d80c4aa89638aea5964a3cd8193a6dd8abf939a43b5d562c24dbab08ff1 AS oras

FROM python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6

COPY --from=oras /bin/oras /usr/local/bin/oras

COPY build/requirements-model-tools.txt /opt/flexinfer/requirements-model-tools.txt

RUN pip install --no-cache-dir --only-binary=:all: --require-hashes \
    --requirement /opt/flexinfer/requirements-model-tools.txt \
    && pip check

COPY build/scripts/validate_quantized_artifact.py /opt/flexinfer/scripts/validate_quantized_artifact.py
COPY build/scripts/publish_hf.py /opt/flexinfer/scripts/publish_hf.py

RUN python -c "import sys; assert sys.version_info[:2] == (3, 14), sys.version; print(sys.version)" \
    && oras version \
    && python -c "import huggingface_hub, safetensors; print(huggingface_hub.__version__, safetensors.__version__)" \
    && python -m py_compile \
        /opt/flexinfer/scripts/validate_quantized_artifact.py \
        /opt/flexinfer/scripts/publish_hf.py \
    && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/flexinfer/scripts \
        python -c "import publish_hf, validate_quantized_artifact" \
    && python /opt/flexinfer/scripts/validate_quantized_artifact.py --help >/dev/null \
    && rm -rf /opt/flexinfer/scripts/__pycache__

ENTRYPOINT ["/bin/sh"]
