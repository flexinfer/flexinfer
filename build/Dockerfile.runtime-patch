# Thin overlay: patches an existing runtime image with the Gemma4 MoE GPTQ fix
# + updated entrypoint. Takes <2 min to build vs 30+ min for a full rebuild.
#
# Safe default:
#   - remove TurboQuant and its runtime env from standard serving images
# Opt-in canary path:
#   - set INCLUDE_TURBOQUANT=true to keep/install TurboQuant
#   - the source install path applies build/scripts/patch_turboquant_quantizer_gpu_qr.py
#
# Usage:
#   docker build --context 7900xtx -f build/Dockerfile.runtime-patch \
#     --build-arg BASE_IMAGE=registry.harbor.lan/flexinfer/runtime@sha256:... \
#     --build-arg INCLUDE_TURBOQUANT=true \
#     --build-arg TURBOQUANT_INSTALL_MODE=source .
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG INCLUDE_TURBOQUANT=false
ARG TURBOQUANT_INSTALL_MODE=source
ARG TURBOQUANT_REPO=https://github.com/Alberto-Codes/turboquant-vllm.git
ARG TURBOQUANT_REF=main

COPY build/scripts/patch_turboquant_quantizer_gpu_qr.py /opt/flexinfer/scripts/
COPY build/scripts/vllm_gemma4_moe_gptq_patch.py /opt/flexinfer/scripts/
COPY build/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint.sh
RUN chmod +x /usr/local/bin/runtime-entrypoint.sh

# Keep the overlay safe by default: remove TurboQuant from standard serving
# images unless the explicit canary path is selected.
RUN if [ "${INCLUDE_TURBOQUANT}" = "true" ]; then \
      echo "[runtime-patch] TurboQuant enabled for explicit canary image"; \
      if [ "${TURBOQUANT_INSTALL_MODE}" != "source" ]; then \
        echo "[runtime-patch] ERROR: TurboQuant canary overlay requires TURBOQUANT_INSTALL_MODE=source" >&2; \
        exit 1; \
      fi; \
      rm -rf /tmp/turboquant-src && \
      git clone --depth 1 "${TURBOQUANT_REPO}" /tmp/turboquant-src && \
      cd /tmp/turboquant-src && \
      git fetch --depth 1 origin "${TURBOQUANT_REF}" && \
      git checkout FETCH_HEAD && \
      python3 /opt/flexinfer/scripts/patch_turboquant_quantizer_gpu_qr.py /tmp/turboquant-src && \
      pip install --no-cache-dir --no-deps /tmp/turboquant-src && \
      mkdir -p /etc/flexinfer && \
      sed -i '/^TQ4_SHARE_PRIMITIVES=/d' /etc/flexinfer/runtime.env 2>/dev/null || true && \
      sed -i '/^FLEXINFER_EXPERIMENTAL_KV_CACHE_CODEC=/d' /etc/flexinfer/runtime.env 2>/dev/null || true && \
      sed -i '/^FLEXINFER_EXPERIMENTAL_KV_CACHE_CODEC_STATUS=/d' /etc/flexinfer/runtime.env 2>/dev/null || true && \
      printf '%s\n' \
        'FLEXINFER_EXPERIMENTAL_KV_CACHE_CODEC=turboquant' \
        'FLEXINFER_EXPERIMENTAL_KV_CACHE_CODEC_STATUS=plugin' \
        'TQ4_SHARE_PRIMITIVES=1' >> /etc/flexinfer/runtime.env && \
      python3 -c 'import importlib.metadata as md; eps=[e.name for e in md.entry_points(group="vllm.general_plugins")]; assert "tq4_backend" in eps, eps; print("turboquant-vllm", md.version("turboquant-vllm"), "entrypoints", eps)'; \
    else \
      pip uninstall -y turboquant-vllm 2>/dev/null || true; \
      if [ -f /etc/flexinfer/runtime.env ]; then \
        sed -i '/^TQ4_/d' /etc/flexinfer/runtime.env && \
        sed -i '/^FLEXINFER_EXPERIMENTAL_KV_CACHE_CODEC/d' /etc/flexinfer/runtime.env && \
        sed -i '/^FLEXINFER_EXPERIMENTAL_KV_CACHE_CODEC_STATUS/d' /etc/flexinfer/runtime.env; \
      fi; \
    fi

# Apply the GPTQ patch at build time
RUN python3 /opt/flexinfer/scripts/vllm_gemma4_moe_gptq_patch.py
