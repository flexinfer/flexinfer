# MLC-LLM Docker image for AMD GPUs - Built from source for ROCm 6.4
# This builds MLC-LLM against ROCm 6.4 libraries for proper compatibility
FROM rocm/dev-ubuntu-22.04:6.4

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    git \
    curl \
    cmake \
    ninja-build \
    llvm-dev \
    libzstd-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Upgrade pip
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Clone and build TVM with ROCm support
WORKDIR /build
RUN git clone --recursive https://github.com/apache/tvm.git && \
    cd tvm && \
    git checkout v0.18.0 && \
    git submodule update --init --recursive

# Build TVM with explicit ROCm paths
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm/hip
RUN cd /build/tvm && \
    mkdir build && cd build && \
    cp ../cmake/config.cmake . && \
    echo "set(USE_ROCM ON)" >> config.cmake && \
    echo "set(USE_LLVM ON)" >> config.cmake && \
    echo "set(ROCM_PATH /opt/rocm)" >> config.cmake && \
    echo "set(USE_ROCBLAS OFF)" >> config.cmake && \
    echo "set(USE_MIOPEN OFF)" >> config.cmake && \
    cmake -G Ninja \
        -DROCM_PATH=/opt/rocm \
        -DHIP_PATH=/opt/rocm/hip \
        .. && \
    ninja

# Install TVM Python package
RUN cd /build/tvm/python && pip3 install -e .

# Clone and build MLC-LLM
RUN git clone --recursive https://github.com/mlc-ai/mlc-llm.git /build/mlc-llm && \
    cd /build/mlc-llm && \
    git submodule update --init --recursive

# Build MLC-LLM
RUN cd /build/mlc-llm && \
    pip3 install --no-cache-dir -e ".[dev]"

# Install runtime dependencies
RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn \
    transformers \
    sentencepiece \
    tiktoken \
    safetensors \
    huggingface_hub \
    openai \
    httpx \
    shortuuid

# Create non-root user
RUN useradd -m -u 1000 mlc && \
    mkdir -p /models && \
    chown -R mlc:mlc /models /build

# Switch to non-root user
USER mlc
WORKDIR /home/mlc

# Expose the default REST API port
EXPOSE 8000

# Default entrypoint
ENTRYPOINT ["python", "-m", "mlc_llm"]
CMD ["serve", "--help"]
