# Dockerfile.quantizer-gptq-rocm-gfx906
# Thin GPTQ quantizer overlay for AMD Radeon VII (gfx906).
#
# The gfx906 runtime image already carries the ROCm/PyTorch/GPTQModel stack
# needed for quantization. The historical failure here was not missing deps;
# it was that the image lacked the controller's version sentinel files under
# /app and /workspace. Build the smallest possible overlay so deploy-quantizer
# stays fast and we can prove the live job is using the fixed artifact.
#
# Build:
#   docker --context 7900xtx build -f build/Dockerfile.quantizer-gptq-rocm-gfx906 \
#     -t registry.harbor.lan/flexinfer/quantizer:gptq-rocm-gfx906 .

ARG BASE_IMAGE=registry.harbor.lan/flexinfer/runtime@sha256:ba4570f515af05fe62f8b6672449b4029e1f15c2f606412e8d6d800e3e0e2dbf
FROM ${BASE_IMAGE}

# Refresh the controller-managed scripts in case the runtime image lags.
COPY build/scripts/quantize_gptq.py /opt/flexinfer/scripts/quantize_gptq.py
COPY build/scripts/abliterate.py /opt/flexinfer/scripts/abliterate.py

# The controller probes tiny sentinel files for version compatibility before it
# ever executes the full quantize script. Keep those sentinels import-safe.
RUN mkdir -p /app && \
    printf 'FLEXINFER_SCRIPT_VERSION = "v10"\n' > /app/quantize_gptq.py && \
    printf 'FLEXINFER_SCRIPT_VERSION = "v1"\n' > /app/abliterate.py

ENTRYPOINT ["/bin/bash"]
