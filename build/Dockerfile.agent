FROM golang:1.25.5 as builder
WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY agents/ agents/
COPY pkg/ pkg/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o agent ./cmd/flexinfer-agent

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/agent .
# Agents often need privilege to check hardware, but distroless specific
# For now run as root if needed or add capabilities in k8s
ENTRYPOINT ["/agent"]
