# vLLM Docker image for AMD gfx906 (Radeon VII / Vega20)
#
# The earlier source-build image used rocm/dev-ubuntu-24.04:6.4.4 plus the
# PyTorch rocm6.2 wheel and failed during vLLM 0.7.3 CMake configuration. gfx906
# is deprecated in recent ROCm releases, so the stable path is the community
# gfx906 vLLM base that already carries rebuilt ROCm/PyTorch/vLLM components.
#
# Build command:
#   docker build -f build/Dockerfile.vllm-rocm-gfx906 -t vllm-rocm-gfx906 .
#
# Base provenance:
# - docs/dev/gfx906-gpu-support.md documents the adopted mixa3607 gfx906 stack.
# - vLLM is prebuilt in the base image, so this Dockerfile intentionally avoids
#   rebuilding vLLM from source.

ARG BASE_IMAGE=docker.io/mixa3607/vllm-gfx906:0.12.0-rocm-6.3.3-nlzy
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# gfx906 runtime environment.
# Radeon VII hardware can report gfx900; override to gfx906 for correct ISA
# dispatch. SDMA/SVM are disabled because they are fragile on Vega20 with ROCm.
ENV ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm/hip \
    PYTORCH_ROCM_ARCH=gfx906 \
    HSA_OVERRIDE_GFX_VERSION=9.0.6 \
    HSA_ENABLE_SDMA=0 \
    HSA_USE_SVM=0 \
    HIP_VISIBLE_DEVICES=0 \
    ROCR_VISIBLE_DEVICES=0 \
    TORCH_BLAS_PREFER_HIPBLASLT=0 \
    MIOPEN_FIND_MODE=2

# Conservative vLLM defaults for gfx906. Flash attention remains disabled for
# this non-FA image; operators should prefer llama.cpp or this image before any
# experimental FA path on Radeon VII.
ENV VLLM_USE_V1=0 \
    VLLM_USE_TRITON_FLASH_ATTN=0 \
    VLLM_ROCM_USE_AITER=0

WORKDIR /workspace
RUN mkdir -p /models

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=10)"

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
