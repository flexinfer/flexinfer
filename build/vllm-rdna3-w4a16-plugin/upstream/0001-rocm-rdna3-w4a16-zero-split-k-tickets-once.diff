diff --git a/tests/kernels/quantization/test_rdna3_w4a16_tickets.py b/tests/kernels/quantization/test_rdna3_w4a16_tickets.py
new file mode 100644
index 0000000..04a8c2e
--- /dev/null
+++ b/tests/kernels/quantization/test_rdna3_w4a16_tickets.py
@@ -0,0 +1,148 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Split-K ticket pool of the fp16 RDNA3 W4A16 GEMM (gptq_gemm_rdna3).
+
+The scalar kernel reduces its split-K partials in-kernel, gated by one
+arrival ticket per output tile. The tickets come from a per-device pool that
+is zeroed once (csrc/rocm/q_gemm_rdna3.cu, split_k_tickets) instead of a fresh
+at::zeros per call; the kernel re-arms every ticket it uses. These tests pin
+what that must preserve, all against the same op's own eager output:
+
+A. no zero-fill kernel per call once the pool exists;
+B. a CUDA graph captured on a side stream replays bit-identically, many times;
+C. two graphs captured on one stream replay alternately without interference;
+D. eager calls racing on two streams stay correct (distinct slots);
+E. a graph captured before the pool exists (per-call fallback) is correct.
+
+E must run first in a fresh process, so it lives in its own subprocess.
+"""
+
+import subprocess
+import sys
+import textwrap
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+
+if not current_platform.is_rocm():
+    pytest.skip("RDNA3 W4A16 kernel is ROCm-only", allow_module_level=True)
+
+from vllm import _custom_ops as ops  # noqa: E402
+from vllm.platforms.rocm import on_gfx1100  # noqa: E402
+
+pytestmark = pytest.mark.skipif(
+    not (
+        on_gfx1100()
+        and hasattr(torch.ops, "_rocm_C")
+        and hasattr(torch.ops._rocm_C, "gptq_gemm_rdna3")
+    ),
+    reason="requires gfx1100 with the _rocm_C.gptq_gemm_rdna3 op built in",
+)
+
+GROUP = 128
+# K > 256 so the call splits K and takes tickets; N spans several tiles.
+K, N = 4352, 5120
+
+
+def _weights(seed=0):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    qweight = torch.randint(
+        -(2**31), 2**31 - 1, (K // 8, N), dtype=torch.int32, device="cuda",
+        generator=g,
+    )
+    qzeros = torch.randint(
+        -(2**31), 2**31 - 1, (K // GROUP, N // 8), dtype=torch.int32,
+        device="cuda", generator=g,
+    )
+    scales = (
+        torch.rand(K // GROUP, N, dtype=torch.float16, device="cuda", generator=g)
+        * 0.01
+    )
+    return qweight, qzeros, scales
+
+
+def _gemm(a, w):
+    return ops.gptq_gemm_rdna3(a, *w, False)
+
+
+@pytest.mark.parametrize("m", [1, 3, 6])
+def test_no_fill_per_call(m):
+    from torch.profiler import ProfilerActivity, profile
+
+    w = _weights()
+    a = torch.randn(m, K, dtype=torch.float16, device="cuda")
+    _gemm(a, w)  # creates the pool
+    torch.cuda.synchronize()
+    with profile(activities=[ProfilerActivity.CUDA]) as prof:
+        for _ in range(10):
+            _gemm(a, w)
+        torch.cuda.synchronize()
+    names = [e.name for e in prof.events() if "CUDA" in str(e.device_type)]
+    assert sum("gemm_q4_kernel_rdna3" in n for n in names) == 10
+    assert not [n for n in names if "fill" in n.lower()], names
+
+
+@pytest.mark.parametrize("m", [1, 3, 6])
+def test_graphs_and_streams(m):
+    w = _weights()
+    a1 = torch.randn(m, K, dtype=torch.float16, device="cuda")
+    a2 = torch.randn(m, K, dtype=torch.float16, device="cuda")
+    ref1, ref2 = _gemm(a1, w), _gemm(a2, w)
+    side = torch.cuda.Stream()
+    with torch.cuda.stream(side):
+        _gemm(a1, w)
+    torch.cuda.synchronize()
+    g1, g2 = torch.cuda.CUDAGraph(), torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g1, stream=side):
+        o1 = _gemm(a1, w)
+        o1b = _gemm(a1, w)
+    with torch.cuda.graph(g2, stream=side):
+        o2 = _gemm(a2, w)
+    for _ in range(25):  # B, C
+        g1.replay()
+        g2.replay()
+        torch.cuda.synchronize()
+        assert torch.equal(o1, ref1) and torch.equal(o1b, ref1)
+        assert torch.equal(o2, ref2)
+    s_a, s_b = torch.cuda.Stream(), torch.cuda.Stream()
+    for _ in range(25):  # D
+        with torch.cuda.stream(s_a):
+            xa = _gemm(a1, w)
+        with torch.cuda.stream(s_b):
+            xb = _gemm(a2, w)
+        torch.cuda.synchronize()
+        assert torch.equal(xa, ref1) and torch.equal(xb, ref2)
+
+
+def test_capture_before_pool_exists():
+    script = textwrap.dedent(
+        f"""
+        import torch
+        from vllm import _custom_ops as ops
+        K, N, G = {K}, {N}, {GROUP}
+        qw = torch.randint(-2**31, 2**31 - 1, (K // 8, N), dtype=torch.int32, device="cuda")
+        qz = torch.randint(-2**31, 2**31 - 1, (K // G, N // 8), dtype=torch.int32, device="cuda")
+        sc = torch.rand(K // G, N, dtype=torch.float16, device="cuda") * 0.01
+        a = torch.randn(3, K, dtype=torch.float16, device="cuda")
+        # Load the kernel module with a one-split call (no tickets, no pool).
+        ops.gptq_gemm_rdna3(torch.randn(3, 256, dtype=torch.float16, device="cuda"),
+                            qw[:32].contiguous(), qz[:2].contiguous(), sc[:2].contiguous(), False)
+        side = torch.cuda.Stream()
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g, stream=side):
+            out = ops.gptq_gemm_rdna3(a, qw, qz, sc, False)
+        ref = ops.gptq_gemm_rdna3(a, qw, qz, sc, False)
+        for _ in range(10):
+            g.replay()
+            torch.cuda.synchronize()
+            assert torch.equal(out, ref)
+        print("ok")
+        """
+    )
+    result = subprocess.run(
+        [sys.executable, "-c", script], capture_output=True, text=True
+    )
+    assert result.returncode == 0 and "ok" in result.stdout, result.stderr
