         logger.debug("wvSplitKrc workspace warmup failed", exc_info=True)
 
 
+def warmup_rocm_rdna3_w4a16_tickets(device: torch.device) -> None:
+    """Eagerly create gptq_gemm_rdna3's per-device split-K ticket pool.
+
+    The fp16 scalar W4A16 kernel on gfx1100 reduces its split-K partials in
+    the kernel, gated by one arrival ticket per output tile. The tickets live
+    in a per-device pool that is zeroed once (csrc/rocm/q_gemm_rdna3.cu,
+    split_k_tickets); eager streams and capturing streams each take a slot.
+    The pool is otherwise created by the first eager qualifying GEMM. Like
+    wvSplitKrc's pool above it should exist before the KV cache backing buffer
+    and before any cudagraph capture: a call captured with no pool falls back
+    to a per-call zeroed array, which is correct but puts one fill per GEMM
+    back into the graph.
+    """
+    from vllm.platforms.rocm import on_gfx1100
+
+    if not on_gfx1100() or not hasattr(torch.ops._rocm_C, "gptq_gemm_rdna3"):
+        return
+    try:
+        # K = 512 is two K splits, so the fp16 path takes tickets.
+        x = torch.zeros(1, 512, dtype=torch.float16, device=device)
+        qweight = torch.zeros(512 // 8, 64, dtype=torch.int32, device=device)
+        qzeros = torch.zeros(4, 64 // 8, dtype=torch.int32, device=device)
+        scales = torch.zeros(4, 64, dtype=torch.float16, device=device)
+        ops.gptq_gemm_rdna3(x, qweight, qzeros, scales, False)
+    except Exception:
+        logger.debug("gptq_gemm_rdna3 ticket pool warmup failed", exc_info=True)
+
+
