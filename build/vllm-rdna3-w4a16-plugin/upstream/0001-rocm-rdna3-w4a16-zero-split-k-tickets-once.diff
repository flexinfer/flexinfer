+      if (capturing) {
+        auto it = pool.capture_slot_of.find(stream);
+        if (it != pool.capture_slot_of.end()) {
+          slot = it->second;
+        } else if (pool.next_capture_slot < kTicketCaptureSlots) {
+          slot = static_cast<int>(kTicketSlots) + pool.next_capture_slot++;
+          pool.capture_slot_of.emplace(stream, slot);
+        }
+      } else {
+        auto it = pool.slot_of.find(stream);
+        if (it != pool.slot_of.end()) {
+          slot = it->second;
+        } else if (pool.next_slot < kTicketSlots) {
+          slot = pool.next_slot++;
+          pool.slot_of.emplace(stream, slot);
+        }
+      }
+      if (slot >= 0) {
+        return pool.tickets.data_ptr<int>() + slot * kTicketsPerSlot;
+      }
+    }
+  }
+  spill = at::zeros({needed}, dev_opts.dtype(at::kInt));
+  return spill.data_ptr<int>();
+}
