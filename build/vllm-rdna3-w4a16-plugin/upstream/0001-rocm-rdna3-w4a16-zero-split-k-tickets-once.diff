+static constexpr int64_t kTicketCaptureSlots = 8;
+static constexpr int64_t kTicketsPerSlot = 8192;  // (x, y) tiles per call
+
+static int* split_k_tickets(int64_t needed, const at::TensorOptions& dev_opts,
+                            cudaStream_t stream, at::Tensor& spill) {
+  struct TicketPool {
+    at::Tensor tickets;
+    int next_slot = 0;
+    int next_capture_slot = 0;
+    std::map<cudaStream_t, int> slot_of;
+    std::map<cudaStream_t, int> capture_slot_of;
+  };
+  static std::mutex pool_mu;
+  static std::map<int, TicketPool> pools;
+
+  // A stream whose capture was invalidated reports an error; treat it as not
+  // capturing, since that capture is lost either way.
+  cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+  unsigned long long capture_id = 0;
+  if (cudaStreamGetCaptureInfo(stream, &capture_status, &capture_id) !=
+      cudaSuccess) {
+    capture_status = cudaStreamCaptureStatusNone;
+  }
+  const bool capturing = capture_status != cudaStreamCaptureStatusNone;
+
+  if (needed <= kTicketsPerSlot) {
+    std::lock_guard<std::mutex> lock(pool_mu);
+    TicketPool& pool = pools[dev_opts.device().index()];
+    if (!pool.tickets.defined() && !capturing) {
+      pool.tickets = at::zeros(
+          {kTicketsPerSlot * (kTicketSlots + kTicketCaptureSlots)},
+          dev_opts.dtype(at::kInt));
+      // The lock orders host access to the slot maps, not device execution:
+      // without this, another stream could be handed a slot that the fill
+      // above has not cleared yet.
