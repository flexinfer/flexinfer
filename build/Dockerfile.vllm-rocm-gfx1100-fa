# vLLM for AMD gfx1100 (RX 7900 series) with flash attention
# Uses AMD's prebuilt Navi-optimized image — no from-source compilation needed.
#
# Base: ROCm 7.2, PyTorch 2.9, vLLM 0.14.0rc0 with FA via AOTriton
# V1 is the only engine in vLLM 0.14.0+ (V0 removed in 0.11)
#
# Build: docker build -f build/Dockerfile.vllm-rocm-gfx1100-fa -t vllm:rocm-gfx1100-fa .

ARG BASE_IMAGE=rocm/vllm-dev:rocm7.2_navi_ubuntu24.04_py3.12_pytorch_2.9_vllm_0.14.0rc0
FROM ${BASE_IMAGE}

ENV PYTORCH_ROCM_ARCH=gfx1100
ENV DEBIAN_FRONTEND=noninteractive

# ROCm environment for gfx1100
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
# Faster kernel dispatch on ROCm
ENV HIP_FORCE_DEV_KERNARG=1

# V1 is the only engine — DO NOT set VLLM_USE_V1 (removed env var in 0.12+)
# Triton flash attention: enabled by default in Navi images
ENV VLLM_USE_TRITON_FLASH_ATTN=1
# AWQ quantization via Triton (required for AWQ models on ROCm)
ENV VLLM_USE_TRITON_AWQ=1
# AITER: disabled (MI300X-optimized, not RDNA3)
ENV VLLM_ROCM_USE_AITER=0

# Extra dependencies not in base
RUN pip install --no-cache-dir \
    diffusers>=0.30.0 \
    pillow \
    sentencepiece \
    protobuf \
    "numpy<2"

WORKDIR /workspace
RUN mkdir -p /models

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["python", "-m", "vllm.entrypoints.openai.api_server"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
