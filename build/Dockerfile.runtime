# Parameterized flexinfer-runtime Dockerfile.
# Builds a unified runtime image for any GPU profile (gfx1100, gfx906, cuda-maxwell).
#
# All build args are injected by build/build-runtime.sh from build/runtime.yaml.
# Do NOT build this file directly — use the build script.
#
# Usage:
#   ./build/build-runtime.sh gfx1100
#   ./build/build-runtime.sh gfx906 --push
#   ./build/build-runtime.sh cuda-maxwell --dry-run

# ── Global ARGs (before first FROM) ──────────────────────────────────
ARG BASE_IMAGE
ARG GO_VERSION=1.26.0
ARG LLAMACPP_VERSION=b8173
ARG OLLAMA_VERSION=v0.17.4
ARG OLLAMA_GO_VERSION=1.25.7
ARG AMDGPU_TARGETS=gfx1100
ARG GPU_VENDOR=amd
ARG GPU_ARCH=gfx1100
ARG INCLUDE_VLLM=false
ARG INCLUDE_LLAMACPP=true
ARG INCLUDE_OLLAMA=true
ARG INCLUDE_DIFFUSERS=false
ARG INCLUDE_BITSANDBYTES=false
ARG INCLUDE_STEAM=false
ARG INCLUDE_QUANTIZER=false
ARG TRANSFORMERS_CONSTRAINT=">=5.0"
# Builder base image — ROCm dev or CUDA devel depending on vendor
ARG LLAMACPP_BUILD_IMAGE=rocm/dev-ubuntu-24.04:6.4.4
# CUDA architecture for NVIDIA builds
ARG CUDA_ARCHITECTURES=52

# ── Stage 1: Build flexinfer-runtime Go binary ──────────────────────
FROM golang:${GO_VERSION} AS go-builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY backend/ backend/
COPY internal/ internal/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY scheduler/ scheduler/
COPY agents/ agents/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o /runtime cmd/flexinfer-runtime/main.go

# ── Stage 2: Build llama.cpp ─────────────────────────────────────────
FROM ${LLAMACPP_BUILD_IMAGE} AS llamacpp-builder

ARG LLAMACPP_VERSION
ARG AMDGPU_TARGETS
ARG GPU_VENDOR
ARG CUDA_ARCHITECTURES

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build build-essential curl \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then echo "hipblas-dev rocblas-dev"; fi) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/src
RUN git clone --depth 1 --branch ${LLAMACPP_VERSION} https://github.com/ggml-org/llama.cpp.git

WORKDIR /opt/src/llama.cpp
# For CUDA (llama.cpp b8173+): link driver stubs for VMM API (cuMemCreate, cuMemMap)
RUN if [ "${GPU_VENDOR}" = "nvidia" ]; then \
      ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/libcuda.so.1 && ldconfig; \
    fi
RUN cmake -B build -G Ninja \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then \
      echo "-DGGML_HIP=ON -DGGML_NATIVE=OFF -DAMDGPU_TARGETS=${AMDGPU_TARGETS}"; \
    else \
      echo "-DGGML_CUDA=ON -DGGML_NATIVE=OFF -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}"; \
    fi) \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j$(nproc)

# ── Stage 3: Build ollama ────────────────────────────────────────────
FROM ${LLAMACPP_BUILD_IMAGE} AS ollama-builder

ARG OLLAMA_VERSION
ARG OLLAMA_GO_VERSION
ARG GPU_VENDOR
ARG CUDA_ARCHITECTURES

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake make gcc g++ curl ca-certificates \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then echo "hipblas-dev rocblas-dev"; fi) \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${OLLAMA_GO_VERSION}.linux-amd64.tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /build
RUN git clone --depth 1 --branch "${OLLAMA_VERSION}" https://github.com/ollama/ollama.git .

ENV CGO_ENABLED=1
# Set CUDA architectures for NVIDIA ollama builds
RUN if [ "${GPU_VENDOR}" = "nvidia" ]; then \
      export CUDA_ARCHITECTURES="50;52" && \
      export CMAKE_CUDA_ARCHITECTURES="50;52"; \
    fi && \
    go generate ./... && go build -trimpath -o /build/ollama .

# ── Stage 4: Runtime ─────────────────────────────────────────────────
FROM ${BASE_IMAGE} AS runtime

ARG GPU_VENDOR
ARG GPU_ARCH
ARG INCLUDE_VLLM
ARG INCLUDE_LLAMACPP
ARG INCLUDE_OLLAMA
ARG INCLUDE_DIFFUSERS
ARG INCLUDE_BITSANDBYTES
ARG INCLUDE_STEAM
ARG INCLUDE_QUANTIZER
ARG TRANSFORMERS_CONSTRAINT

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV GPU_VENDOR=${GPU_VENDOR}
ENV GPU_ARCH=${GPU_ARCH}

# ── System dependencies ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl tini jq lsof procps psmisc \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then echo "hipblas rocblas"; fi) \
    $(if [ "${INCLUDE_VLLM}" = "true" ]; then echo "build-essential git pkg-config python3-dev"; fi) \
    && rm -rf /var/lib/apt/lists/*

# ── Fix urllib3 (DEFAULT_CIPHERS removed in 2.0, breaks ROCm base) ──
RUN if [ "${GPU_VENDOR}" = "amd" ] && command -v pip >/dev/null 2>&1; then \
      pip install --no-cache-dir "urllib3<2"; \
    fi

# ── Diffusers stack (conditional) ────────────────────────────────────
# --no-deps prevents CUDA torch contamination on ROCm base images.
# TRANSFORMERS_CONSTRAINT and INCLUDE_BITSANDBYTES vary per profile:
#   gfx1100: transformers>=5.0, bitsandbytes=true (pip wheel has gfx1100 HIP kernels)
#   gfx906:  transformers>=4.57,<5 (PyTorch 2.3), bitsandbytes=false (no gfx906 HIP kernels in pip)
RUN if [ "${INCLUDE_DIFFUSERS}" = "true" ] && command -v pip >/dev/null 2>&1; then \
      BNB_FLAG=""; \
      if [ "${INCLUDE_BITSANDBYTES}" = "true" ]; then BNB_FLAG="bitsandbytes"; fi; \
      pip install --no-cache-dir --no-deps \
        "diffusers>=0.30.0" \
        accelerate \
        "transformers${TRANSFORMERS_CONSTRAINT}" \
        ${BNB_FLAG}; \
      pip install --no-cache-dir \
        safetensors \
        pillow \
        sentencepiece \
        protobuf \
        "numpy<2" \
        huggingface-hub \
        regex \
        pyyaml \
        psutil \
        packaging \
        fastapi \
        uvicorn; \
    fi

# ── vLLM (conditional) ──────────────────────────────────────────────
# vLLM 0.17.0 (V1-only engine) with ROCm 7.0 pre-built wheel.
# --no-deps prevents replacing ROCm PyTorch from the base image.
# transformers>=5.0 required for Qwen3.5 model_type recognition.
# Qwen3.5's fast path needs both flash-linear-attention and causal-conv1d.
# Do not silently swallow causal-conv1d failures; otherwise the unified runtime
# ships a guaranteed slow path for this model family.
RUN if [ "${INCLUDE_VLLM}" = "true" ] && command -v pip >/dev/null 2>&1; then \
      pip install --no-cache-dir --no-deps \
        "vllm==0.17.0+rocm700" \
        --extra-index-url https://wheels.vllm.ai/rocm/0.17.0/rocm700; \
      pip install --no-cache-dir \
        "transformers>=5.0" \
        partial-json-parser msgspec gguf aiohttp \
        lm-format-enforcer outlines mistral_common \
        compressed-tensors depyf cloudpickle \
        prometheus-client prometheus-fastapi-instrumentator \
        py-cpuinfo psutil pyzmq uvloop \
        flash-linear-attention; \
      export ROCM_PATH="${ROCM_PATH:-/opt/rocm}" HIP_PATH="${HIP_PATH:-/opt/rocm}" MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
      pip install --no-cache-dir --no-build-isolation "causal-conv1d>=1.5.0.post8"; \
      python3 -c 'import importlib.util; missing=[name for name in ("fla","causal_conv1d") if importlib.util.find_spec(name) is None]; assert not missing, f"missing Qwen3.5 fast-path deps: {missing}"; print("Qwen3.5 fast-path deps installed")'; \
    fi

# ── Steam headless (conditional) ──────────────────────────────────────
RUN if [ "${INCLUDE_STEAM}" = "true" ]; then \
      echo "steam steam/question select I AGREE" | debconf-set-selections && \
      echo "steam steam/license note" | debconf-set-selections && \
      dpkg --add-architecture i386 && \
      apt-get update && apt-get install -y --no-install-recommends \
        steamcmd lib32gcc-s1 \
        xvfb x11-utils pulseaudio dbus-x11 && \
      rm -rf /var/lib/apt/lists/*; \
    fi
COPY build/steam-headless.sh /opt/flexinfer/steam-headless.sh
RUN chmod +x /opt/flexinfer/steam-headless.sh

# ── Quantizer packages (conditional) ─────────────────────────────────
# Adds GPTQModel, datasets, and oras CLI to the runtime image so that
# quantization jobs can use the same image instead of separate 60GB+ quantizer images.
RUN if [ "${INCLUDE_QUANTIZER}" = "true" ] && command -v pip >/dev/null 2>&1; then \
      pip install -v "gptqmodel @ git+https://github.com/ModelCloud/GPTQModel.git@main" \
        --no-build-isolation --no-deps; \
      pip install --no-cache-dir \
        datasets zstandard safetensors accelerate sentencepiece \
        huggingface_hub protobuf pillow hf_transfer device-smi \
        tokenizers logbar maturin pyarrow dill defuser; \
      # numpy ABI fix for older ROCm bases (e.g. gfx906 with numpy <1.26)
      if ! python3 -c "import numpy; exit(0 if tuple(map(int,numpy.__version__.split('.')[:2]))>=(1,26) else 1)" 2>/dev/null; then \
        pip uninstall -y numba llvmlite 2>/dev/null || true; \
        pip install --force-reinstall "numpy>=1.26,<2" pandas scipy scikit-learn; \
      fi; \
      # oras CLI for OCI artifact push (model publishing)
      curl -fsSL https://github.com/oras-project/oras/releases/download/v1.2.0/oras_1.2.0_linux_amd64.tar.gz \
        | tar -xz -C /usr/local/bin oras; \
    fi

# ── Profiling and diagnostics tooling ────────────────────────────────
RUN if command -v pip >/dev/null 2>&1; then \
      pip install --no-cache-dir py-spy memray; \
    fi

# ── Quantization/abliteration/finetune scripts ──────────────────────
COPY build/scripts/ /opt/flexinfer/scripts/
RUN chmod +x /opt/flexinfer/scripts/*.sh /opt/flexinfer/scripts/*.py 2>/dev/null || true

# ── Verify ROCm PyTorch was not replaced by CUDA ────────────────────
RUN if [ "${GPU_VENDOR}" = "amd" ] && command -v python3 >/dev/null 2>&1; then \
      python3 -c "import torch; assert torch.version.hip is not None, 'CUDA torch detected!'; print('OK: PyTorch', torch.__version__, 'HIP', torch.version.hip)"; \
    fi

# ── Profile env vars (generated by build-runtime.sh) ────────────────
# These are baked into the image as permanent environment variables.
# The file is generated per-profile and COPY'd during build.
COPY build/.runtime-env /etc/flexinfer/runtime.env

COPY build/server-diffusers.py /opt/flexinfer/server-diffusers.py
COPY build/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint.sh

# ── Copy llama.cpp binary ────────────────────────────────────────────
COPY --from=llamacpp-builder /opt/src/llama.cpp/build/bin/ /opt/llamacpp/bin/
ENV PATH="/opt/llamacpp/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llamacpp/bin:${LD_LIBRARY_PATH}"

# ── Copy ollama binary ───────────────────────────────────────────────
COPY --from=ollama-builder /build/ollama /usr/local/bin/ollama
ENV OLLAMA_MODELS=/models/ollama

# ── Copy flexinfer-runtime binary ────────────────────────────────────
COPY --from=go-builder /runtime /usr/local/bin/flexinfer-runtime

RUN mkdir -p /models /var/lib/flexinfer/compile-cache

WORKDIR /workspace

EXPOSE 8080 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

ENTRYPOINT ["tini", "--", "runtime-entrypoint.sh"]
CMD ["flexinfer-runtime", "--listen", ":8080"]
