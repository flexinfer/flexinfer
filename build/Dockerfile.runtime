# Parameterized flexinfer-runtime Dockerfile.
# Builds a unified runtime image for any GPU profile (gfx1100, gfx906, cuda-maxwell).
#
# All build args are injected by build/build-runtime.sh from build/runtime.yaml.
# Do NOT build this file directly — use the build script.
#
# Usage:
#   ./build/build-runtime.sh gfx1100
#   ./build/build-runtime.sh gfx906 --push
#   ./build/build-runtime.sh cuda-maxwell --dry-run

# ── Global ARGs (before first FROM) ──────────────────────────────────
ARG BASE_IMAGE
ARG GO_VERSION=1.26.0
ARG LLAMACPP_VERSION=b8173
ARG OLLAMA_VERSION=v0.17.4
ARG OLLAMA_GO_VERSION=1.25.7
ARG AMDGPU_TARGETS=gfx1100
ARG GPU_VENDOR=amd
ARG GPU_ARCH=gfx1100
ARG INCLUDE_VLLM=false
ARG INCLUDE_LLAMACPP=true
ARG INCLUDE_OLLAMA=true
ARG INCLUDE_DIFFUSERS=false
ARG INCLUDE_BITSANDBYTES=false
ARG INCLUDE_STEAM=false
ARG INCLUDE_GAMING=false
ARG INCLUDE_QUANTIZER=false
ARG TRANSFORMERS_CONSTRAINT=">=5.0"
ARG TRANSFORMERS_INSTALL_MODE=constraint
ARG TRANSFORMERS_REPO=https://github.com/huggingface/transformers.git
ARG TRANSFORMERS_REF=main
ARG TRANSFORMERS_PACKAGE=""
ARG TRANSFORMERS_RUNTIME_INSTALL=disabled
ARG VLLM_INSTALL_MODE=wheel
ARG VLLM_VERSION=0.17.0+rocm700
ARG VLLM_EXTRA_INDEX_URL=https://wheels.vllm.ai/rocm/0.17.0/rocm700
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF=main
ARG VLLM_SOURCE_PATCH_SCRIPT=
ARG VLLM_EXTRA_DEPS_PROFILE=full
# Set to "true" to skip the legacy vllm_gemma4_moe_gptq_patch at build time.
# Required for vLLM >=0.19 profiles where upstream native FusedMoE supplants
# the legacy patch; partial-apply of the legacy patch corrupts the native
# code path and causes container exits at init.
# See .loom/slice3-v1-sandbox-rms-norm-falsified-2026-05-15.md (gemma4-moe-patch
# section) for the post-mortem that drove this knob.
ARG SKIP_GEMMA4_MOE_PATCH=false
ARG INSTALL_QWEN35_FASTPATH=true
ARG INCLUDE_TURBOQUANT=false
ARG TURBOQUANT_INSTALL_MODE=none
ARG TURBOQUANT_VERSION=1.4.0
ARG TURBOQUANT_REPO=https://github.com/Alberto-Codes/turboquant-vllm.git
ARG TURBOQUANT_REF=main
ARG TURBOQUANT_SOURCE_PATCH_SCRIPT=
# Builder base image — ROCm dev or CUDA devel depending on vendor
ARG LLAMACPP_BUILD_IMAGE=rocm/dev-ubuntu-24.04:6.4.4
# CUDA architecture for NVIDIA builds
ARG CUDA_ARCHITECTURES=52

# ── Stage 1: Build flexinfer-runtime Go binary ──────────────────────
FROM golang:${GO_VERSION} AS go-builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY backend/ backend/
COPY internal/ internal/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY scheduler/ scheduler/
COPY agents/ agents/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o /runtime cmd/flexinfer-runtime/main.go

# ── Stage 2: Build llama.cpp ─────────────────────────────────────────
FROM ${LLAMACPP_BUILD_IMAGE} AS llamacpp-builder

ARG LLAMACPP_VERSION
ARG AMDGPU_TARGETS
ARG GPU_VENDOR
ARG CUDA_ARCHITECTURES

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build build-essential curl \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then echo "hipblas-dev rocblas-dev"; fi) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/src
RUN git clone --depth 1 --branch ${LLAMACPP_VERSION} https://github.com/ggml-org/llama.cpp.git

WORKDIR /opt/src/llama.cpp
# For CUDA (llama.cpp b8173+): link driver stubs for VMM API (cuMemCreate, cuMemMap)
RUN if [ "${GPU_VENDOR}" = "nvidia" ]; then \
      ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/libcuda.so.1 && ldconfig; \
    fi
RUN cmake -B build -G Ninja \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then \
      echo "-DGGML_HIP=ON -DGGML_NATIVE=OFF -DAMDGPU_TARGETS=${AMDGPU_TARGETS}"; \
    else \
      echo "-DGGML_CUDA=ON -DGGML_NATIVE=OFF -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}"; \
    fi) \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j$(nproc)

# ── Stage 3: Build ollama ────────────────────────────────────────────
FROM ${LLAMACPP_BUILD_IMAGE} AS ollama-builder

ARG OLLAMA_VERSION
ARG OLLAMA_GO_VERSION
ARG GPU_VENDOR
ARG CUDA_ARCHITECTURES

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake make gcc g++ curl ca-certificates \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then echo "hipblas-dev rocblas-dev"; fi) \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${OLLAMA_GO_VERSION}.linux-amd64.tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /build
RUN git clone --depth 1 --branch "${OLLAMA_VERSION}" https://github.com/ollama/ollama.git .

ENV CGO_ENABLED=1
# Set CUDA architectures for NVIDIA ollama builds
RUN if [ "${GPU_VENDOR}" = "nvidia" ]; then \
      export CUDA_ARCHITECTURES="50;52" && \
      export CMAKE_CUDA_ARCHITECTURES="50;52"; \
    fi && \
    go generate ./... && go build -trimpath -o /build/ollama .

# ── Stage 4: Runtime ─────────────────────────────────────────────────
FROM ${BASE_IMAGE} AS runtime

ARG GPU_VENDOR
ARG GPU_ARCH
ARG INCLUDE_VLLM
ARG INCLUDE_LLAMACPP
ARG INCLUDE_OLLAMA
ARG INCLUDE_DIFFUSERS
ARG INCLUDE_BITSANDBYTES
ARG INCLUDE_STEAM
ARG INCLUDE_GAMING
ARG INCLUDE_QUANTIZER
ARG TRANSFORMERS_CONSTRAINT
ARG TRANSFORMERS_INSTALL_MODE
ARG TRANSFORMERS_REPO
ARG TRANSFORMERS_REF
ARG TRANSFORMERS_PACKAGE
ARG TRANSFORMERS_RUNTIME_INSTALL
ARG VLLM_INSTALL_MODE
ARG VLLM_VERSION
ARG VLLM_EXTRA_INDEX_URL
ARG VLLM_REPO
ARG VLLM_REF
ARG VLLM_SOURCE_PATCH_SCRIPT
ARG VLLM_EXTRA_DEPS_PROFILE
ARG SKIP_GEMMA4_MOE_PATCH
ARG INSTALL_QWEN35_FASTPATH
ARG INCLUDE_TURBOQUANT
ARG TURBOQUANT_INSTALL_MODE
ARG TURBOQUANT_VERSION
ARG TURBOQUANT_REPO
ARG TURBOQUANT_REF
ARG TURBOQUANT_SOURCE_PATCH_SCRIPT

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV GPU_VENDOR=${GPU_VENDOR}
ENV GPU_ARCH=${GPU_ARCH}
ENV FLEXINFER_TRANSFORMERS_PACKAGE=${TRANSFORMERS_PACKAGE}
ENV FLEXINFER_TRANSFORMERS_RUNTIME_INSTALL=${TRANSFORMERS_RUNTIME_INSTALL}

COPY build/scripts/ /opt/flexinfer/scripts/
RUN chmod +x /opt/flexinfer/scripts/*.sh /opt/flexinfer/scripts/*.py 2>/dev/null || true

# ── Quarantine stale AMD ROCm apt sources ────────────────────────────
# Some ROCm base images ship an apt source that resolves only inside AMD's
# internal network. When that host is unreachable, apt emits hard warnings and
# can become a source of build flakiness. Disable only the broken source.
RUN if [ "${GPU_VENDOR}" = "amd" ]; then \
      if ! getent hosts compute-artifactory.amd.com >/dev/null 2>&1; then \
        for src in /etc/apt/sources.list.d/*.list; do \
          [ -e "${src}" ] || continue; \
          if grep -Eq 'compute-artifactory\.amd\.com|rocm-osdb-24\.04-deb|compute-rocm-rel-7\.2' "${src}" 2>/dev/null; then \
            mv "${src}" "${src}.disabled" && echo "Disabled stale AMD apt source: ${src}"; \
          fi; \
        done; \
      fi; \
    fi

# ── System dependencies ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl tini jq lsof procps psmisc \
    $(if [ "${GPU_VENDOR}" = "amd" ]; then echo "hipblas rocblas"; fi) \
    $(if [ "${INCLUDE_VLLM}" = "true" ] || [ "${VLLM_INSTALL_MODE}" = "source" ] || [ "${TRANSFORMERS_INSTALL_MODE}" = "source" ]; then echo "build-essential git pkg-config python3-dev"; fi) \
    && rm -rf /var/lib/apt/lists/*

# ── Fix urllib3 (DEFAULT_CIPHERS removed in 2.0, breaks ROCm base) ──
RUN if [ "${GPU_VENDOR}" = "amd" ] && command -v pip >/dev/null 2>&1; then \
      pip install --no-cache-dir "urllib3<2"; \
    fi

# ── Diffusers stack (conditional) ────────────────────────────────────
# --no-deps prevents CUDA torch contamination on ROCm base images.
# TRANSFORMERS_CONSTRAINT / TRANSFORMERS_INSTALL_MODE and INCLUDE_BITSANDBYTES vary per profile:
#   gfx1100: transformers>=5.0, bitsandbytes=true (pip wheel has gfx1100 HIP kernels)
#   gfx906:  transformers>=4.57,<5 (PyTorch 2.3), bitsandbytes=false (no gfx906 HIP kernels in pip)
#   gfx1100-gemma4-experimental: transformers from main branch source
RUN if [ "${INCLUDE_DIFFUSERS}" = "true" ] && command -v pip >/dev/null 2>&1; then \
      BNB_FLAG=""; \
      if [ "${INCLUDE_BITSANDBYTES}" = "true" ]; then BNB_FLAG="bitsandbytes"; fi; \
      if [ "${TRANSFORMERS_INSTALL_MODE}" = "source" ]; then \
        rm -rf /tmp/transformers-src && \
        git clone --depth 1 "${TRANSFORMERS_REPO}" /tmp/transformers-src && \
        cd /tmp/transformers-src && \
        git fetch --depth 1 origin "${TRANSFORMERS_REF}" && \
        git checkout FETCH_HEAD && \
        pip install --no-cache-dir /tmp/transformers-src; \
      else \
        pip install --no-cache-dir --no-deps "transformers${TRANSFORMERS_CONSTRAINT}"; \
      fi; \
      pip install --no-cache-dir --no-deps \
        "diffusers>=0.30.0" \
        accelerate \
        ${BNB_FLAG}; \
      pip install --no-cache-dir \
        safetensors \
        pillow \
        sentencepiece \
        protobuf \
        "numpy<2" \
        huggingface-hub \
        regex \
        pyyaml \
        psutil \
        packaging \
        fastapi \
        uvicorn; \
    fi

# ── vLLM (conditional) ──────────────────────────────────────────────
# vLLM is either installed from the pinned ROCm wheel (stable runtime path) or
# from a source ref (experimental runtime path for Gemma4 bring-up).
# --no-deps prevents replacing ROCm PyTorch from the base image.
# transformers>=5.0 required for Qwen3.5 model_type recognition.
# Qwen3.5's fast path needs both flash-linear-attention and causal-conv1d.
# Do not silently swallow causal-conv1d failures; otherwise the unified runtime
# ships a guaranteed slow path for this model family.
RUN if [ "${INCLUDE_VLLM}" = "true" ] && command -v pip >/dev/null 2>&1; then \
      if [ "${VLLM_INSTALL_MODE}" = "source" ]; then \
        pip uninstall -y vllm 2>/dev/null || true; \
        rm -rf /var/lib/jenkins/vllm /workspace/vllm /tmp/vllm-src; \
        git clone --depth 1 "${VLLM_REPO}" /tmp/vllm-src && \
        cd /tmp/vllm-src && \
        git fetch --depth 1 origin "${VLLM_REF}" && \
        git checkout FETCH_HEAD && \
        if [ -n "${VLLM_SOURCE_PATCH_SCRIPT}" ]; then \
          python3 "/opt/flexinfer/scripts/$(basename "${VLLM_SOURCE_PATCH_SCRIPT}")" /tmp/vllm-src; \
        fi && \
        if [ "${GPU_VENDOR}" = "amd" ]; then \
          export PYTORCH_ROCM_ARCH="${GPU_ARCH}" HCC_AMDGPU_TARGET="${GPU_ARCH}"; \
          export CMAKE_ARGS="${CMAKE_ARGS:+${CMAKE_ARGS} }-DGPU_TARGETS=${GPU_ARCH}"; \
          echo "Constraining vLLM ROCm build to GPU_TARGETS=${GPU_ARCH}"; \
        fi && \
        pip install --no-cache-dir cmake ninja packaging "setuptools>=74" wheel jinja2 && \
        pip install --no-cache-dir --no-build-isolation /tmp/vllm-src || exit 1; \
      else \
        pip install --no-cache-dir --no-deps \
          "vllm==${VLLM_VERSION}" \
          --extra-index-url "${VLLM_EXTRA_INDEX_URL}"; \
      fi; \
      if [ "${TRANSFORMERS_INSTALL_MODE}" = "source" ]; then \
        rm -rf /tmp/transformers-src && \
        git clone --depth 1 "${TRANSFORMERS_REPO}" /tmp/transformers-src && \
        cd /tmp/transformers-src && \
        git fetch --depth 1 origin "${TRANSFORMERS_REF}" && \
        git checkout FETCH_HEAD && \
        pip install --no-cache-dir /tmp/transformers-src; \
      else \
        pip install --no-cache-dir "transformers${TRANSFORMERS_CONSTRAINT}"; \
      fi; \
      # `mistral_common>=1.10.0,<2` is required by transformers 5.x's
      # `tokenization_mistral_common.py`, which imports `ReasoningEffort`
      # from `mistral_common.protocol.instruct.request`. The symbol was
      # introduced in mistral_common 1.10.0 (2026-03-13). Without an
      # explicit constraint, pip can resolve to an older release if the
      # transitive dep chain pins it lower, and `AutoProcessor`'s
      # dynamic class-registry walk crashes the moment any multimodal
      # model (e.g. Whisper) is loaded — see kill-test v4 evidence in
      # .loom/ralph-whisper-kill-test-v4-evidence-2026-05-20.md.
      if [ "${VLLM_EXTRA_DEPS_PROFILE}" = "minimal" ]; then \
        pip install --no-cache-dir \
          partial-json-parser msgspec gguf aiohttp \
          lm-format-enforcer "mistral_common>=1.10.0,<2" \
          depyf cloudpickle \
          prometheus-client prometheus-fastapi-instrumentator \
          py-cpuinfo psutil pyzmq uvloop; \
      else \
        pip install --no-cache-dir \
          partial-json-parser msgspec gguf aiohttp \
          lm-format-enforcer outlines "mistral_common>=1.10.0,<2" \
          compressed-tensors depyf cloudpickle \
          prometheus-client prometheus-fastapi-instrumentator \
          py-cpuinfo psutil pyzmq uvloop; \
      fi; \
      python3 -c "from mistral_common.protocol.instruct.request import ReasoningEffort; print('mistral_common ReasoningEffort import OK:', ReasoningEffort)"; \
      if [ "${INSTALL_QWEN35_FASTPATH}" = "true" ]; then \
        export ROCM_PATH="${ROCM_PATH:-/opt/rocm}" HIP_PATH="${HIP_PATH:-/opt/rocm}" MAX_JOBS="${MAX_JOBS:-$(nproc)}"; \
        export HIP_ARCHITECTURES="${GPU_ARCH}" HCC_AMDGPU_TARGET="${GPU_ARCH}" PYTORCH_ROCM_ARCH="${GPU_ARCH}"; \
        pip install --no-cache-dir flash-linear-attention; \
        pip install --no-cache-dir --no-build-isolation "causal-conv1d>=1.5.0.post8"; \
        python3 -c 'import importlib.util; missing=[name for name in ("fla","causal_conv1d") if importlib.util.find_spec(name) is None]; assert not missing, f"missing Qwen3.5 fast-path deps: {missing}"; print("Qwen3.5 fast-path deps installed")'; \
      else \
        echo "Skipping Qwen3.5 fast-path deps for this vLLM profile"; \
      fi; \
      python3 -c 'import pathlib, transformers, vllm; root = pathlib.Path(vllm.__file__).resolve().parent / "model_executor" / "models"; hits = sorted(p.name for p in root.glob("gemma4*.py")); print("transformers", transformers.__version__); print("vLLM", vllm.__version__, "Gemma4 model files:", hits if hits else "none")'; \
    fi

# ── TurboQuant vLLM plugin (conditional) ────────────────────────────
# Install without deps so the plugin cannot rewrite the experimental Gemma4
# runtime stack. This must stay opt-in because the plugin currently declares
# transformers<5 while the Gemma4 path uses transformers@main.
RUN if [ "${INCLUDE_TURBOQUANT}" = "true" ] && command -v pip >/dev/null 2>&1; then \
      if [ "${TURBOQUANT_INSTALL_MODE}" = "source" ]; then \
        rm -rf /tmp/turboquant-src && \
        git clone --depth 1 "${TURBOQUANT_REPO}" /tmp/turboquant-src && \
        cd /tmp/turboquant-src && \
        git fetch --depth 1 origin "${TURBOQUANT_REF}" && \
        git checkout FETCH_HEAD && \
        if [ -n "${TURBOQUANT_SOURCE_PATCH_SCRIPT}" ]; then \
          python3 "/opt/flexinfer/scripts/$(basename "${TURBOQUANT_SOURCE_PATCH_SCRIPT}")" /tmp/turboquant-src; \
        fi && \
        pip install --no-cache-dir --no-deps /tmp/turboquant-src; \
      else \
        pip install --no-cache-dir --no-deps "turboquant-vllm==${TURBOQUANT_VERSION}"; \
      fi; \
      python3 -c 'import importlib.metadata as md; eps = [e.name for e in md.entry_points(group="vllm.general_plugins") if e.name == "tq4_backend"]; print("turboquant-vllm", md.version("turboquant-vllm")); print("tq4_entrypoints", eps)'; \
    fi

# ── Steam headless (conditional) ──────────────────────────────────────
RUN if [ "${INCLUDE_STEAM}" = "true" ]; then \
      echo "steam steam/question select I AGREE" | debconf-set-selections && \
      echo "steam steam/license note" | debconf-set-selections && \
      dpkg --add-architecture i386 && \
      apt-get update && apt-get install -y --no-install-recommends \
        steamcmd lib32gcc-s1 \
        xvfb x11-utils pulseaudio dbus-x11 && \
      rm -rf /var/lib/apt/lists/*; \
    fi
COPY build/steam-headless.sh /opt/flexinfer/steam-headless.sh
RUN chmod +x /opt/flexinfer/steam-headless.sh

# ── Gaming mode: Sunshine + headless wlroots + Mesa RADV/VA-API (conditional) ──
# The default gaming backend (SunshineBackend). Installs the GPU graphics +
# hardware-encode userspace the ROCm compute base lacks:
#   - Mesa RADV (Vulkan render) + radeonsi VA-API (H.264/HEVC/AV1 HW encode),
#     validated on gfx1100 by the Slice 1 kill-test.
#   - sway: a headless wlroots compositor (WLR_BACKENDS=headless) that hosts the
#     game and exposes the wlr-screencopy output Sunshine captures. gamescope is
#     NOT packaged for Ubuntu 24.04; it can be layered from source later as an
#     in-session micro-compositor for scaling/HDR/frame-limit ergonomics.
#   - vulkan-tools/vainfo for diagnostics.
#   - PipeWire/PulseAudio for game audio over Moonlight; steamcmd so Steam/Proton
#     titles can be launched under Sunshine.
# Sunshine itself is fetched from the LizardByte release (.deb) for Ubuntu 24.04.
ARG SUNSHINE_VERSION=0.23.1
RUN if [ "${INCLUDE_GAMING}" = "true" ]; then \
      dpkg --add-architecture i386 && \
      apt-get update && apt-get install -y --no-install-recommends \
        mesa-vulkan-drivers mesa-va-drivers libva2 vainfo \
        vulkan-tools libgl1-mesa-dri \
        sway foot libseat1 seatd dbus-x11 \
        avahi-daemon avahi-utils \
        pipewire pipewire-pulse wireplumber pulseaudio-utils \
        steamcmd lib32gcc-s1 \
        curl ca-certificates && \
      curl -fsSL -o /tmp/sunshine.deb \
        "https://github.com/LizardByte/Sunshine/releases/download/v${SUNSHINE_VERSION}/sunshine-ubuntu-24.04-amd64.deb" && \
      apt-get install -y --no-install-recommends /tmp/sunshine.deb && \
      rm -f /tmp/sunshine.deb && \
      rm -rf /var/lib/apt/lists/*; \
    fi
COPY build/sunshine-headless.sh /opt/flexinfer/sunshine-headless.sh
RUN chmod +x /opt/flexinfer/sunshine-headless.sh

# ── Quantizer packages (conditional) ─────────────────────────────────
# Adds GPTQModel, datasets, and oras CLI to the runtime image so that
# quantization jobs can use the same image instead of separate 60GB+ quantizer images.
RUN set -e; \
    if [ "${INCLUDE_QUANTIZER}" = "true" ] && command -v pip >/dev/null 2>&1; then \
      # Bake the Qwen3.5-compatible transformers build into the runtime so GPTQ
      # jobs do not need to mutate the environment on every start.
      pip install --no-cache-dir --no-deps \
        "git+https://github.com/huggingface/transformers.git@529504b2fa98970c6c44d3fafaeb07a39c40e7ea"; \
      pip install --no-cache-dir tokenicer pypcre; \
      pip install -v "gptqmodel @ git+https://github.com/ModelCloud/GPTQModel.git@205ca72d2567789a337c1de4fa3f69da249d93c0" \
        --no-build-isolation --no-deps; \
      pip install --no-cache-dir \
        kernels torchao \
        datasets zstandard safetensors accelerate sentencepiece \
        huggingface_hub protobuf pillow hf_transfer device-smi \
        tokenizers logbar maturin pyarrow dill defuser; \
      # numpy ABI fix for older ROCm bases (e.g. gfx906 with numpy <1.26)
      if ! python3 -c "import numpy; exit(0 if tuple(map(int,numpy.__version__.split('.')[:2]))>=(1,26) else 1)" 2>/dev/null; then \
        pip uninstall -y numba llvmlite 2>/dev/null || true; \
        pip install --force-reinstall "numpy>=1.26,<2" pandas scipy scikit-learn; \
      fi; \
      # oras CLI for OCI artifact push (model publishing)
      curl -fsSL https://github.com/oras-project/oras/releases/download/v1.2.0/oras_1.2.0_linux_amd64.tar.gz \
        | tar -xz -C /usr/local/bin oras; \
      mkdir -p /etc/flexinfer && touch /etc/flexinfer/quantizer-deps-baked; \
      python3 -c "import gptqmodel, tokenicer, pcre, kernels, torchao"; \
    fi

# ── Profiling and diagnostics tooling ────────────────────────────────
RUN if command -v pip >/dev/null 2>&1; then \
      pip install --no-cache-dir py-spy memray; \
    fi

# ── Apply vLLM Qwen3.5 patches at build time ────────────────────────
# Patches the pinned wheel path for Qwen3.5 GDN text model support.
# Source-based experimental builds should carry native support already.
RUN if [ "${INCLUDE_VLLM}" = "true" ] && [ "${VLLM_INSTALL_MODE}" = "wheel" ] && [ -f /opt/flexinfer/scripts/vllm_qwen35_patches_nodiag.py ]; then \
      python3 /opt/flexinfer/scripts/vllm_qwen35_patches_nodiag.py && \
      echo "vLLM Qwen3.5 patches applied at build time"; \
    fi

# ── Apply vLLM Gemma4 MoE GPTQ patch at build time ──────────────────
# GPTQConfig.get_quant_method always applies MoeWNA16 to FusedMoE layers,
# even when experts are excluded from GPTQ (attention-only quantization).
# This patch checks modules_in_block_to_quantize and skips MoE quantization
# when no MoE-related modules are in the list.
#
# 2026-05-15: gated on SKIP_GEMMA4_MOE_PATCH. vLLM 0.19+ native gemma4
# FusedMoE supplants this legacy patch; partial-apply of the legacy patch
# against 0.19 source corrupts the native code path and causes container
# exits at init. Sandbox / source-build vLLM-0.19 profiles must set this
# build arg to "true" via build/runtime.yaml.
# See .loom/slice3-v1-sandbox-rms-norm-falsified-2026-05-15.md (Z2-Z1
# rollback-2 section).
RUN if [ "${SKIP_GEMMA4_MOE_PATCH}" = "true" ]; then \
      FLEXINFER_GEMMA4_MOE_NATIVE_COMPAT_ONLY=1 python3 /opt/flexinfer/scripts/vllm_gemma4_moe_gptq_patch.py && \
      echo "vLLM Gemma4 legacy MoE GPTQ patch SKIPPED; native activation compat applied (SKIP_GEMMA4_MOE_PATCH=true)"; \
    elif [ "${INCLUDE_VLLM}" = "true" ] && [ -f /opt/flexinfer/scripts/vllm_gemma4_moe_gptq_patch.py ]; then \
      python3 /opt/flexinfer/scripts/vllm_gemma4_moe_gptq_patch.py && \
      echo "vLLM Gemma4 MoE GPTQ patch applied at build time"; \
    fi

# ── Pre-warm vLLM JIT caches at build time (Wave 1 Slice 7 cold-load fix) ──
# vLLM 0.19+ on ROCm gfx1100 compiles AITER's HIP module + vLLM custom fusions
# at first import. With cold JIT caches, pod startup can exceed the kubelet
# readiness probe budget when Flux triggers a Deployment recreate, leading to
# CrashLoopBackOff. Pre-warming during the Docker build bakes the compiled
# artifacts into the image layer so cold-loads skip the slow path.
#
# Best-effort: failure here (e.g. no ROCm dev tools available, network issue
# resolving an import) emits a warning but does not fail the build — the
# runtime can still JIT at startup as a fallback.
#
# See .loom/slice3-v1-sandbox-rms-norm-falsified-2026-05-15.md (post-promotion
# failure section) for the cold-load incident this addresses.
RUN if [ "${INCLUDE_VLLM}" = "true" ] && [ -f /opt/flexinfer/scripts/prewarm_vllm_jit.py ]; then \
      echo "Pre-warming vLLM JIT caches..."; \
      python3 /opt/flexinfer/scripts/prewarm_vllm_jit.py \
        || echo "WARNING: vLLM JIT prewarm failed; runtime will JIT at pod startup"; \
    fi

# ── Verify ROCm PyTorch was not replaced by CUDA ────────────────────
RUN if [ "${GPU_VENDOR}" = "amd" ] && command -v python3 >/dev/null 2>&1; then \
      python3 -c "import torch; assert torch.version.hip is not None, 'CUDA torch detected!'; print('OK: PyTorch', torch.__version__, 'HIP', torch.version.hip)"; \
    fi

# ── Profile env vars (generated by build-runtime.sh) ────────────────
# These are baked into the image as permanent environment variables.
# The file is generated per-profile and COPY'd during build.
COPY build/.runtime-env /etc/flexinfer/runtime.env

COPY build/server-diffusers.py /opt/flexinfer/server-diffusers.py
COPY build/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint.sh
RUN chmod +x /usr/local/bin/runtime-entrypoint.sh

# ── Copy llama.cpp binary ────────────────────────────────────────────
COPY --from=llamacpp-builder /opt/src/llama.cpp/build/bin/ /opt/llamacpp/bin/
ENV PATH="/opt/llamacpp/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llamacpp/bin:${LD_LIBRARY_PATH}"

# ── Copy ollama binary ───────────────────────────────────────────────
COPY --from=ollama-builder /build/ollama /usr/local/bin/ollama
ENV OLLAMA_MODELS=/models/ollama

# ── Copy flexinfer-runtime binary ────────────────────────────────────
COPY --from=go-builder /runtime /usr/local/bin/flexinfer-runtime

RUN mkdir -p /models /var/lib/flexinfer/compile-cache

WORKDIR /workspace

EXPOSE 8080 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/runtime-entrypoint.sh"]
CMD ["flexinfer-runtime", "--listen", ":8080"]
