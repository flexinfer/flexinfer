# MLC-LLM Docker image for NVIDIA Maxwell GPUs (GTX 980 Ti, etc.)
# Built from source with CUDA 11.8 and architecture 52
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev \
    git cmake ninja-build \
    curl wget \
    libx11-6 libvulkan1 \
    llvm-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Install Rust (required for tokenizers)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Python build dependencies INCLUDING CYTHON
# Cython is REQUIRED for tvm-ffi package installation (compiles core.pyx -> core.cpython-*.so)
# scikit-build-core, ninja, and setuptools-scm are needed for tvm-ffi's pyproject.toml-based build
RUN pip3 install --no-cache-dir numpy pybind11 typing_extensions packaging cython scikit-build-core cmake setuptools-scm ninja

# Clone MLC-LLM with submodules
WORKDIR /build
RUN git clone --recursive https://github.com/mlc-ai/mlc-llm.git

# Build TVM with CUDA 11.8 and Maxwell support (compute capability 52)
# NOTE: CUTLASS is disabled because Maxwell lacks native FP16 operations (__hfma2)
# that CUTLASS requires. This will use cuBLAS fallback instead.
WORKDIR /build/mlc-llm/3rdparty/tvm
RUN mkdir -p build && cd build && \
    echo "set(USE_CUDA ON)" >> config.cmake && \
    echo "set(CMAKE_CUDA_ARCHITECTURES 52)" >> config.cmake && \
    echo "set(USE_CUBLAS ON)" >> config.cmake && \
    echo "set(USE_CUTLASS OFF)" >> config.cmake && \
    echo "set(USE_LLVM ON)" >> config.cmake && \
    echo "set(USE_GRAPH_EXECUTOR ON)" >> config.cmake && \
    echo "set(USE_PROFILER ON)" >> config.cmake && \
    cmake -G Ninja .. && \
    ninja -j$(nproc)

# Build tvm-ffi shared library (produces libtvm_ffi.so)
WORKDIR /build/mlc-llm/3rdparty/tvm/3rdparty/tvm-ffi
RUN mkdir -p build && cd build && \
    cmake -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        .. && \
    ninja -j$(nproc)

# Install tvm-ffi Python package BEFORE TVM
# This triggers Cython compilation of core.pyx -> core.cpython-*.so
# Must set library path so the Cython extension can find libtvm_ffi.so at import time
# NOTE: pyproject.toml is in the tvm-ffi root, not in python/ subdirectory
# --no-build-isolation allows pip to use system cmake/ninja instead of isolated env
ENV LD_LIBRARY_PATH="/build/mlc-llm/3rdparty/tvm/3rdparty/tvm-ffi/build/lib:${LD_LIBRARY_PATH}"
WORKDIR /build/mlc-llm/3rdparty/tvm/3rdparty/tvm-ffi
RUN TVM_FFI=cython pip3 install --no-cache-dir --no-build-isolation .

# Install TVM Python package
# Set TVM_LIBRARY_PATH so TVM can find libtvm.so during installation
ENV TVM_LIBRARY_PATH="/build/mlc-llm/3rdparty/tvm/build"
ENV LD_LIBRARY_PATH="/build/mlc-llm/3rdparty/tvm/build:${LD_LIBRARY_PATH}"
WORKDIR /build/mlc-llm/3rdparty/tvm/python
RUN pip3 install --no-cache-dir .

# Verify TVM is installed - if the above pip install fails silently, copy source directly
RUN python3 -c "import tvm; print('TVM version:', tvm.__version__)" || \
    (echo "TVM pip install failed, copying source directly..." && \
     cp -r /build/mlc-llm/3rdparty/tvm/python/tvm /usr/local/lib/python3.10/dist-packages/tvm)

# Build MLC-LLM
# -DCMAKE_POLICY_VERSION_MINIMUM=3.5 needed for msgpack compatibility with CMake 4.x
WORKDIR /build/mlc-llm
RUN mkdir -p build && cd build && \
    cmake -G Ninja \
        -DCMAKE_CUDA_ARCHITECTURES=52 \
        -DUSE_CUDA=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        .. && \
    ninja -j$(nproc)

# Install MLC-LLM Python package WITHOUT dependencies
# This avoids the flashinfer-python dependency which requires CUDA 12.6+
# MLC-LLM will fall back to TIR-based KV cache when FlashInfer is unavailable
WORKDIR /build/mlc-llm/python
RUN pip3 install --no-cache-dir --no-deps .

# Install PyTorch with CUDA 11.8 wheels (CUDA 11.8 deprecated in PyTorch 2.8+)
# This installs PyTorch 2.7.x which is the last version supporting CUDA 11.8
RUN pip3 install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cu118

# Install remaining MLC-LLM dependencies (skip flashinfer-python and torch)
# psutil is required by TVM meta_schedule
RUN pip3 install --no-cache-dir \
    datasets fastapi ml_dtypes openai pandas psutil \
    prompt_toolkit requests safetensors sentencepiece \
    shortuuid tiktoken tqdm transformers uvicorn

# Runtime image - using devel for JIT compilation support (nvcc required)
# Note: This adds ~4GB to image size but enables runtime model compilation
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# TVM needs to know where its shared libraries are
ENV TVM_LIBRARY_PATH=/usr/local/lib
ENV LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}

# Install runtime dependencies including LLVM (required by TVM for JIT)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip libx11-6 libvulkan1 libllvm14 llvm-dev ninja-build \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# Copy TVM, tvm-ffi, and MLC-LLM shared libraries
COPY --from=builder /build/mlc-llm/3rdparty/tvm/build/libtvm*.so* /usr/local/lib/
COPY --from=builder /build/mlc-llm/3rdparty/tvm/3rdparty/tvm-ffi/build/lib/libtvm_ffi*.so* /usr/local/lib/
COPY --from=builder /build/mlc-llm/build/libmlc_llm*.so* /usr/local/lib/

# Copy Python packages (includes compiled Cython extensions like core.cpython-*.so)
COPY --from=builder /usr/local/lib/python3.10/dist-packages /usr/local/lib/python3.10/dist-packages

# Update library cache
RUN ldconfig

# Create non-root user
RUN useradd -m -u 1000 mlc && mkdir -p /models && chown -R mlc:mlc /models

USER mlc
WORKDIR /home/mlc

EXPOSE 8000
ENTRYPOINT ["python3", "-m", "mlc_llm"]
CMD ["serve", "--help"]
