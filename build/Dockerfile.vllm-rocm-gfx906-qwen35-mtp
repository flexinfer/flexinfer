# Modern gfx906 Qwen3.5/MTP canary runtime.
#
# The base is the published amd64 artifact built from ai-infos/vllm-gfx906-
# mobydick commit eb450bdf (vLLM 0.20.1 lineage), triton-gfx906 3.6, and the
# native gfx906 PyTorch/ROCm 6.3.3 stack. FlexInfer's overlay installs the
# shared plugin helpers, the text-only dense/MoE registration plugin and the
# sequence-classification (cross-encoder) plugin, and pins the safe runtime
# contract.
#
# FROZEN PLUGINS (2026-11-05, B6 in
# .loom/10-research-backend-currency-gfx1100-gfx906-2026-11-04.md §4): the
# in-tree plugins now target vLLM 0.32+ and dropped the 0.20/0.23/0.26
# compatibility code this 0.20.1 runtime needs (text-class registration,
# hybrid-state copy, M-RoPE donor, label repair). Upstream vLLM has no gfx906
# path, so this image is frozen: it no longer builds from build/vllm-*-plugin
# but copies the plugin sources (plugin-common 0.1.0, text 0.8.0, seqcls 0.1.0,
# commit 7f362d71) out of the image the OpenJEV lane runs and was certified on.
# That image carries pinned-e0aa1e2ef285 in Harbor and stays retained while
# deploy/models/openjev-0p8b-crossencoder-radeonvii.yaml pins it. A plugin fix
# for this lane is a change to those copied sources, made here explicitly.
ARG FROZEN_PLUGINS_IMAGE=registry.harbor.lan/flexinfer/vllm@sha256:e0aa1e2ef28571077dfda14aea05f9a523396e2fc13779c4d11fb2b6c634d445
ARG BASE_IMAGE=docker.io/mixa3607/vllm-gfx906:0.20.1-rocm-6.3.3-aiinfos@sha256:a5a54ee0494ef0a9a351cf7123620f8fe941492906ecb2afec88b3333dd7a6f0
FROM ${FROZEN_PLUGINS_IMAGE} AS frozen-plugins

FROM ${BASE_IMAGE}

ENV HSA_ENABLE_SDMA=0 \
    HSA_USE_SVM=0 \
    PYTORCH_ROCM_ARCH=gfx906 \
    VLLM_USE_TRITON_FLASH_ATTN=0 \
    VLLM_ROCM_USE_AITER=0

# Vega20 cannot service several modern ROCm/VMM probes and kernels used by
# vLLM during initialization. Reuse FlexInfer's established gfx906 shims for
# memory accounting and safe CPU-mirrored parameter initialization.
COPY build/scripts/install_vllm_gfx906_compat.py /tmp/install_vllm_gfx906_compat.py
RUN python3 /tmp/install_vllm_gfx906_compat.py \
    && rm -f /tmp/install_vllm_gfx906_compat.py

# Shared helpers for FlexInfer's vLLM general plugins (ROCm FLA autotune
# pruning, composite-config label resolution, hybrid-state wiring). Every
# plugin below imports this at module scope, and the plugin installs use
# --no-deps, so it must be installed FIRST.
COPY --from=frozen-plugins /opt/flexinfer/vllm-plugin-common /opt/flexinfer/vllm-plugin-common
RUN python3 -m pip install --no-cache-dir --no-deps /opt/flexinfer/vllm-plugin-common \
    && python3 -c 'import flexinfer_vllm_common; assert flexinfer_vllm_common.FLA_OPS_PREFIXES'

COPY --from=frozen-plugins /opt/flexinfer/qwen35-text-plugin /opt/flexinfer/qwen35-text-plugin
RUN python3 -m pip install --no-cache-dir --no-deps /opt/flexinfer/qwen35-text-plugin \
    && python3 -c 'from importlib.metadata import entry_points; assert any(ep.name == "flexinfer_qwen35_text" for ep in entry_points(group="vllm.general_plugins"))'

# Register Qwen3.5 sequence-classification checkpoints (cross-encoder NLI /
# rerank, deploy/models/openjev-0p8b-crossencoder-radeonvii.yaml) as vLLM
# POOLING models; the frozen 0.1.0 copy of the gfx1100 images' package. Pre-wrapping
# with as_seq_cls_model means --runner auto resolves to pooling with no CLI
# flag and no backend change.
#
# Unlike the gfx1100 image, register() cannot be exercised here: this fork
# resolves the GCN arch when vllm/platforms/rocm.py is imported (amdsmi, then
# torch.cuda), so any Qwen3.5 model import fails in a GPU-less builder with
# "No CUDA GPUs are available". register() — including attach_mrope_support,
# which raises if the M-RoPE donor moved — runs in load_general_plugins() at
# engine start, before the model loads, so drift fails the lane's startup
# loudly rather than its first request.
COPY --from=frozen-plugins /opt/flexinfer/qwen35-seqcls-plugin /opt/flexinfer/qwen35-seqcls-plugin
RUN python3 -m pip install --no-cache-dir --no-deps /opt/flexinfer/qwen35-seqcls-plugin \
    && python3 -c 'from importlib.metadata import entry_points; assert any(ep.name == "flexinfer_qwen35_seqcls" for ep in entry_points(group="vllm.general_plugins"))'

WORKDIR /workspace
ENTRYPOINT ["vllm", "serve"]
