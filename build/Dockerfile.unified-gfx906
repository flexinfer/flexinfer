# Dockerfile.unified-gfx906
# Unified runtime image for AMD Radeon VII (gfx906) on FlexInfer.
# Replaces 3 separate images:
#   - quantizer:gptq-rocm-gfx906       (ROCm 6.2.3, PyTorch 2.3, transformers <5)
#   - quantizer:gptq-rocm64-gfx906     (ROCm 6.4.1, PyTorch 2.6, CPU-only)
#   - diffusers:rocm-gfx906            (ROCm 6.2.3, PyTorch 2.3, bitsandbytes)
#
# Base: mixa3607/pytorch-gfx906 — community-maintained PyTorch builds with
# rebuilt rocBLAS+Tensile for gfx906 on ROCm 6.3.3. This restores GPU compute
# that was broken in ROCm 6.4+ (torch.empty(device="cuda") failure).
#
# Capabilities:
#   - GPTQ quantization via GPTQModel (GPU-accelerated, transformers >=5.0)
#   - Abliteration (GPU-accelerated with monkey-patched hipMemGetInfo)
#   - Diffusers inference (SDXL, FLUX) with bitsandbytes NF4
#   - GGUF conversion via llama.cpp (CPU-only, uses 128GB system RAM)
#
# Multi-stage build:
#   - "builder" stage: compiles bitsandbytes from source (needs cmake, ninja,
#     gcc, build-essential, git). Produces a built wheel.
#   - "runtime" stage: starts fresh from the same base, installs all Python
#     deps and copies in the prebuilt bitsandbytes wheel. Drops the compile
#     toolchain to keep the runtime image slim.
#
# GPU validation required before first use:
#   docker run --device=/dev/kfd --device=/dev/dri \
#     -e HSA_OVERRIDE_GFX_VERSION=9.0.6 \
#     mixa3607/pytorch-gfx906:v2.9.0-rocm-6.3.3 \
#     python3 -c "import torch; x = torch.randn(1024, device='cuda'); print('OK:', x.mean())"
#
# Build:
#   docker --context 7900xtx build -f build/Dockerfile.unified-gfx906 \
#     -t registry.harbor.lan/flexinfer/runtime:unified-gfx906 .

ARG PYTORCH_GFX906_TAG=v2.9.0-rocm-6.3.3

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: builder — compile bitsandbytes for gfx906
# ─────────────────────────────────────────────────────────────────────────────
FROM docker.io/mixa3607/pytorch-gfx906:${PYTORCH_GFX906_TAG} AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1

# Compile toolchain only — discarded after this stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake ninja-build build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# bitsandbytes from source (NF4/INT8 for gfx906).
# pip wheel only ships HIP kernels for gfx90a/gfx942/gfx1100. Build with
# COMPUTE_BACKEND=hip for gfx906 kernel support. The conda compiler_compat
# linker may be incompatible — rename during build then restore after.
# scikit-build-core is bnb's PEP 517 backend (BNB_SKIP_CMAKE=1 still needs it
# present for metadata generation, just not for the cmake invocation).
# We install bitsandbytes into the builder's site-packages, then export the
# package files for the runtime stage via COPY --from=builder.
RUN COMPILER_COMPAT=$(find / -path "*/compiler_compat" -type d 2>/dev/null | head -1) && \
    if [ -n "$COMPILER_COMPAT" ]; then mv "$COMPILER_COMPAT" "${COMPILER_COMPAT}.bak"; fi && \
    # Pin setuptools below 78 (newer is strict about `project.license`
    # in bitsandbytes 0.49.2's pyproject.toml). scikit-build-core is bnb's
    # PEP 517 backend (BNB_SKIP_CMAKE=1 still needs it for metadata).
    python3 -m pip install --ignore-installed "setuptools>=70,<78" wheel && \
    python3 -m pip install scikit-build-core && \
    git clone --depth 1 --branch 0.49.2 \
        https://github.com/bitsandbytes-foundation/bitsandbytes.git /tmp/bnb && \
    cd /tmp/bnb && \
    cmake -DCOMPUTE_BACKEND=hip -S . -B build && \
    cmake --build build -j"$(nproc)" && \
    # cmake placed the HIP .so at /tmp/bnb/bitsandbytes/libbitsandbytes_rocm*.so.
    # `pip wheel` builds a wheel that includes everything in the package dir,
    # so the .so ships with it. BNB_SKIP_CMAKE=1 disables the cmake build path
    # in bnb's setup hook (we already built it manually above).
    mkdir -p /out && \
    BNB_SKIP_CMAKE=1 python3 -m pip wheel --no-deps --no-build-isolation -w /out . && \
    if [ -n "$COMPILER_COMPAT" ] && [ -d "${COMPILER_COMPAT}.bak" ]; then \
        mv "${COMPILER_COMPAT}.bak" "$COMPILER_COMPAT"; \
    fi && \
    ls -la /out/ && \
    # Verify the wheel actually contains the HIP .so (sanity check before
    # the runtime stage tries to install it).
    python3 -c "import zipfile, glob, sys; \
        whl=glob.glob('/out/bitsandbytes-*.whl')[0]; \
        names=zipfile.ZipFile(whl).namelist(); \
        sos=[n for n in names if n.endswith('.so')]; \
        print('SO files in wheel:', sos); \
        sys.exit(0 if any('rocm' in s or 'hip' in s for s in sos) else 1)"

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: runtime — slim image without compile toolchain
# ─────────────────────────────────────────────────────────────────────────────
FROM docker.io/mixa3607/pytorch-gfx906:${PYTORCH_GFX906_TAG} AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1

# ── gfx906 runtime environment ──────────────────────────────────────────────
# Hardware reports gfx900; override to gfx906 for correct ISA dispatch.
# HSA_USE_SVM=0 works around hipMemGetInfo crash (ROCm/ROCm#2433).
# TORCH_BLAS_PREFER_HIPBLASLT=0 disables hipBLASLt (not available on GCN5).
ENV PYTORCH_ROCM_ARCH=gfx906 \
    HSA_OVERRIDE_GFX_VERSION=9.0.6 \
    HSA_ENABLE_SDMA=0 \
    HSA_USE_SVM=0 \
    TORCH_BLAS_PREFER_HIPBLASLT=0 \
    MIOPEN_FIND_MODE=2 \
    HF_HUB_DISABLE_XET=1

# ── System runtime deps + base pip tooling ──────────────────────────────────
# git is needed for the GPTQModel `git+https://...` install below; curl is
# kept for HF download fallback. cmake/ninja/build-essential are NOT installed
# here — bitsandbytes was already compiled in the builder stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --ignore-installed "setuptools>=77" wheel "packaging>=24.2" \
    && python3 -m pip cache purge \
    && find / -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true

# ── All Python dependencies + Triton + GPTQModel + numpy ABI fix ─────────────
# Consolidated into ONE layer so caches/__pycache__/.dist-info junk is purged
# in the same overlay. This is the largest layer; keeping it monolithic avoids
# duplicate metadata across layers.
#
# Triton: the ROCm/PyTorch image families (incl. mixa3607's rebuild) ship a
# broken editable Triton install at /var/lib/jenkins/triton/python that lacks
# the jit API. Replace it with the PyPI wheel (3.2.0 has full ROCm/HIP).
#
# GPTQModel: --no-deps prevents pulling CUDA torch>=2.8.0. pypcre must be
# present during metadata generation. Pinned commit for reproducibility.
#
# transformers>=5.0: enables Qwen3.5, Llama4, modern architectures. The key
# unlock vs. the old ROCm 6.2.3 image. torchao is intentionally excluded —
# wheels can SIGILL on the Broadwell-class hosts that back gfx906 nodes;
# GPTQModel still quantizes correctly without it.
#
# numpy ABI: ROCm PyTorch 2.6 was compiled against numpy 1.x. numpy 2.x →
# RuntimeError. numba/llvmlite are removed (not used; ABI-incompatible).
# pandas/scipy/sklearn are NOT directly imported by FlexInfer scripts but
# are pulled transitively via datasets/pyarrow; force-reinstall keeps their
# numpy 1.26 ABI matched. scipy is load-bearing for the GPTQ MAGMA-fallback
# patch in pkg/quantization/gptq.go (cholesky/eigh/svd/qr).
RUN python3 -m pip install --force-reinstall triton==3.2.0 \
    && python3 -m pip install pypcre \
    && python3 -m pip install -v "gptqmodel @ git+https://github.com/ModelCloud/GPTQModel.git@205ca72d2567789a337c1de4fa3f69da249d93c0" \
        --no-build-isolation --no-deps \
    && python3 -m pip install \
        "transformers>=5.0" \
        safetensors \
        "accelerate>=1.0" \
        datasets \
        sentencepiece \
        huggingface_hub \
        hf_transfer \
        protobuf \
        pillow \
        device-smi \
        kernels \
        tokenicer \
        logbar \
        maturin \
        pyarrow \
        dill \
        pypcre \
        zstandard \
        defuser \
        "diffusers>=0.36.0" \
        "fastapi>=0.115" \
        "uvicorn[standard]>=0.34" \
        pydantic \
        python-multipart \
        aiofiles \
    && python3 -m pip uninstall -y numba llvmlite 2>/dev/null || true \
    && python3 -m pip install --force-reinstall \
        "numpy>=1.26,<2" \
        pandas \
        scipy \
        scikit-learn \
    && python3 -m pip cache purge \
    && find / -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true \
    && find / -name "*.py[co]" -delete 2>/dev/null || true \
    && rm -rf /root/.cache /tmp/* /var/tmp/* 2>/dev/null || true

# ── bitsandbytes (prebuilt in builder stage) ────────────────────────────────
COPY --from=builder /out/*.whl /tmp/
RUN python3 -m pip install --no-cache-dir --no-deps /tmp/bitsandbytes-*.whl \
    && rm -f /tmp/bitsandbytes-*.whl \
    && python3 -m pip cache purge \
    && find / -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true \
    && find / -name "*.py[co]" -delete 2>/dev/null || true

# ── FlexInfer scripts + final marker ────────────────────────────────────────
COPY build/scripts/abliterate.py /opt/flexinfer/scripts/abliterate.py
COPY build/scripts/abliterate_safety.py /opt/flexinfer/scripts/abliterate_safety.py
COPY build/scripts/quantize_gptq.py /opt/flexinfer/scripts/quantize_gptq.py
COPY build/scripts/qwen35_wrap_to_vl_layout.py /opt/flexinfer/scripts/qwen35_wrap_to_vl_layout.py
COPY build/scripts/qwen35_unwrap_from_vl_layout.py /opt/flexinfer/scripts/qwen35_unwrap_from_vl_layout.py
COPY build/server-diffusers.py /opt/flexinfer/server-diffusers.py

RUN mkdir -p /etc/flexinfer /models \
    && touch /etc/flexinfer/quantizer-deps-baked

EXPOSE 8000

ENTRYPOINT ["/bin/bash"]
