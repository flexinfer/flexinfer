# Unified flexinfer-runtime image for AMD gfx906 (Radeon VII, Vega20)
# Contains: flexinfer-runtime manager + vLLM + llamacpp + ollama + diffusers(experimental)
#
# Build command:
#   docker --context radeonvii build -f build/Dockerfile.runtime-rocm-gfx906 \
#     -t registry.harbor.lan/flexinfer/runtime:rocm-gfx906 .
#
# Notes:
#   - gfx906 reports as gfx900, requires HSA_OVERRIDE_GFX_VERSION=9.0.6
#   - No FP8 support, no native flash attention
#   - SDMA disabled for stability
#   - transformers pinned <5 (PyTorch 2.3 constraint)

# ── Stage 1: Build flexinfer-runtime Go binary ──────────────────────
FROM golang:1.26.0 AS go-builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY backend/ backend/
COPY internal/ internal/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY scheduler/ scheduler/
COPY agents/ agents/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o /runtime cmd/flexinfer-runtime/main.go

# ── Stage 2: Build llama.cpp with HIP for gfx906 ───────────────────
ARG ROCM_VERSION=6.2.3
FROM rocm/dev-ubuntu-22.04:${ROCM_VERSION} AS llamacpp-builder

ARG LLAMACPP_VERSION=b8173
ARG AMDGPU_TARGETS=gfx906

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build build-essential curl \
    hipblas-dev rocblas-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/src
RUN git clone --depth 1 --branch ${LLAMACPP_VERSION} https://github.com/ggml-org/llama.cpp.git

WORKDIR /opt/src/llama.cpp
RUN cmake -B build -G Ninja \
    -DGGML_HIP=ON \
    -DGGML_NATIVE=OFF \
    -DAMDGPU_TARGETS=${AMDGPU_TARGETS} \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j$(nproc)

# ── Stage 3: Build ollama with ROCm for gfx906 ─────────────────────
FROM rocm/dev-ubuntu-22.04:${ROCM_VERSION} AS ollama-builder

ARG OLLAMA_VERSION=v0.17.4
ARG GO_VERSION=1.25.7

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake make gcc g++ curl ca-certificates \
    hipblas-dev rocblas-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /build
RUN git clone --depth 1 --branch "${OLLAMA_VERSION}" https://github.com/ollama/ollama.git .

ENV CGO_ENABLED=1
RUN go generate ./... && go build -trimpath -o /build/ollama .

# ── Stage 4: Runtime image ──────────────────────────────────────────
ARG ROCM_PYTORCH_TAG=rocm6.2.3_ubuntu22.04_py3.10_pytorch_2.3.0
FROM rocm/pytorch:${ROCM_PYTORCH_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# ROCm environment for gfx906 (Radeon VII)
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm/hip
ENV HSA_OVERRIDE_GFX_VERSION=9.0.6
ENV HSA_ENABLE_SDMA=0
ENV HSA_USE_SVM=0
ENV PYTORCH_ROCM_ARCH=gfx906

# vLLM settings for gfx906
ENV VLLM_USE_V1=0
ENV VLLM_USE_TRITON_FLASH_ATTN=0
ENV VLLM_ROCM_USE_AITER=0

# Runtime GPU vendor/arch for the flexinfer-runtime manager
ENV GPU_VENDOR=amd
ENV GPU_ARCH=gfx906

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl tini \
    hipblas rocblas \
    && rm -rf /var/lib/apt/lists/*

# ── Install vLLM ────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    vllm==0.7.3 \
    diffusers>=0.30.0 \
    pillow \
    sentencepiece \
    protobuf \
    "numpy<2"

# ── Install diffusers server (experimental on gfx906) ──────────────
RUN pip install --no-cache-dir \
    accelerate \
    safetensors \
    "transformers>=4.57,<5"

COPY build/server-diffusers.py /opt/flexinfer/server-diffusers.py

# ── Copy llama.cpp binary ───────────────────────────────────────────
COPY --from=llamacpp-builder /opt/src/llama.cpp/build/bin/ /opt/llamacpp/bin/
ENV PATH="/opt/llamacpp/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llamacpp/bin:${LD_LIBRARY_PATH}"

# ── Copy ollama binary ──────────────────────────────────────────────
COPY --from=ollama-builder /build/ollama /usr/local/bin/ollama
ENV OLLAMA_MODELS=/models/ollama

# ── Copy flexinfer-runtime binary ───────────────────────────────────
COPY --from=go-builder /runtime /usr/local/bin/flexinfer-runtime

RUN mkdir -p /models /var/lib/flexinfer/compile-cache

WORKDIR /workspace

EXPOSE 8080 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

ENTRYPOINT ["tini", "--", "flexinfer-runtime"]
CMD ["--listen", ":8080", "--gpu-vendor", "amd", "--gpu-arch", "gfx906"]
