[
  {
    "hooks": [
      {
        "type": "command",
        "command": {{ printf `INPUT=$(cat); AGENT_CACHE_DIR="${HOME:-${TMPDIR:-/tmp}}/.cache/loom"; WS_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"; WS_HASH="$(printf '%%s' "$WS_ROOT" | cksum | cut -d' ' -f1)"; for f in "$AGENT_CACHE_DIR"/agent-id-*-"${WS_HASH}"*; do [ -s "$f" ] && AGENT_ID="$(cat "$f")" && break; done; SCRIPT="${WS_ROOT}/mcp/skills/session-retro/scripts/session-retro.sh"; if [ -x "$SCRIPT" ]; then LOOM_BINARY=%s AGENT_ID="${AGENT_ID:-unknown}" "$SCRIPT" 2>>"${TMPDIR:-/tmp}/loom-agent-hooks.log" || true; fi; exit 0` .LoomCmd | jsonString }}
      }
    ]
  }
]
