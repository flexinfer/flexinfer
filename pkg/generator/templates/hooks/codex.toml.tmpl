{{- /*
Codex CLI config.toml preamble. EPIC 3 / CONFIG-4 (.loom/108).

The dot value is a *codexTemplateContext (see configs_codex.go) with all
registry overrides and agent-safety policy already resolved. Output goes
straight to the StringBuilder used by GenerateConfigsWithPath.

HOOK SURFACE: Codex shipped a Claude-style [hooks] block in v0.129.0
(2026-05-07). We emit `notify = [...]` here (still supported — deprecation
attempt reverted in PR #21152) AND a Claude-shape hooks.json alongside
(generated by generateHooksConfig). The `features = { ..., hooks = true }`
line tells Codex to load hooks.json. See VENDOR_SPECS.md "Codex [hooks]"
section for the canonical → vendor mapping.
*/ -}}
{{- if .ApprovalPolicyGranular }}
approval_policy = { granular = { {{ .ApprovalPolicyGranular }} } }

{{- else }}
approval_policy = {{ printf "%q" .ApprovalPolicyStr }}

{{- end }}

{{ if .SuppressWarning -}}
suppress_unstable_features_warning = true
{{ end -}}
features = { {{ .Features }} }

sandbox_mode = {{ printf "%q" .SandboxMode }}
sandbox_workspace_write = { network_access = true, writable_roots = [{{ printf "%q" .WorkspaceRoot }}] }

{{ if .WebSearchMode -}}
web_search = {{ printf "%q" .WebSearchMode }}

{{ end -}}
{{- if or .Model .ModelReasoningEffort -}}
{{- if .Model }}
model = {{ printf "%q" .Model }}
{{- end }}
{{- if .ModelReasoningEffort }}
model_reasoning_effort = {{ printf "%q" .ModelReasoningEffort }}
{{- end }}

{{ end -}}
{{- if .PolicyComment }}{{ .PolicyComment }}
{{ end -}}
# Git safety policy: treat pre-existing dirty worktrees as baseline context.
{{ if .DirtyWorktreeIsScoped -}}
# Continue on current branch/worktree; stage+commit only files changed for the active task.
# Before creating another multi-file worktree, inspect existing linked trees with git worktree list or workspace-clean --report --worktrees.
# For multi-file work, create repo-local linked trees under <repo>/.worktrees/<branch>.
# Do not create sibling repos under services/, libs/, labs/, or the workspace root.
# Escalate only when new unexpected changes appear in files you are editing.

{{ else -}}
# Dirty-worktree mode: {{ .DirtyWorktreeMode }}

{{ end -}}
# Agent lifecycle: background keepalive wrapper on turn completion (rate-limited to avoid notify storms)
notify = ["sh", "-c", {{ printf "%q" .NotifyCommand }}, "--"]

{{ if .Agents -}}
[agents]
{{ range .Agents.TopLevelLines }}{{ . }}
{{ end }}

{{ range .Agents.Definitions -}}
[agents.{{ .Name }}]
{{ if .Description -}}
description = {{ printf "%q" .Description }}
{{ end }}
{{ end -}}
{{ end -}}
{{ if .HookTrustEntries -}}
# Self-trust entries for the [hooks] block — without these, Codex v0.129+
# silently skips every hook in hooks.json on the first run because the
# trusted_hash here would otherwise be absent or stale. We regenerate the
# hash whenever hooks.json content changes, so trust survives `loom sync
# codex --regen`. Algorithm matches codex-rs/config/src/fingerprint.rs and
# codex-rs/hooks/src/engine/discovery.rs (see codex_hooks_trust.go).
[hooks.state]
{{ range .HookTrustEntries }}
[hooks.state.{{ printf "%q" .Key }}]
trusted_hash = {{ printf "%q" .TrustedHash }}
{{ end -}}
{{ end -}}
