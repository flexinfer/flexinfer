{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loom.flexinfer.ai/schemas/mcp-config.json",
  "title": "MCP Client Configuration",
  "description": "JSON Schema for MCP client configuration files (Claude Code, VSCode, Antigravity)",
  "type": "object",
  "required": ["mcpServers"],
  "properties": {
    "mcpServers": {
      "type": "object",
      "description": "Map of server names to their configurations",
      "additionalProperties": {
        "$ref": "#/definitions/serverConfig"
      }
    }
  },
  "definitions": {
    "serverConfig": {
      "type": "object",
      "description": "Configuration for a single MCP server",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Path to the server executable or command name",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "description": "Command-line arguments for the server",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "description": "Environment variables to set for the server",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the server"
        },
        "hint": {
          "type": "string",
          "description": "Usage hint for LLM context"
        },
        "timeout": {
          "type": "integer",
          "description": "Request timeout in seconds",
          "minimum": 0
        },
        "always_allow": {
          "type": "array",
          "description": "Tools to auto-approve without confirmation",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
