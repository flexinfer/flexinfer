# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Docker
*.dockerignore
Dockerfile

# Build output
bin/
dist/

# Local Go cache/temp dirs (Codex sandbox)
.gocache/
.gotmp/
.golangci-lint-cache/

# Agent-managed linked worktrees (claude-code spawns under .claude/worktrees;
# canonical user worktrees live under .worktrees and are covered by global ignore)
.claude/worktrees/

# Ad-hoc build logs / pid files (e.g. tmp/build-runtime-gfx1100.log)
tmp/

# --- Loom MCP tooling (local; do not commit) ---
.codex/
.gemini/
.vscode-mcp/

# Per-tool config files
.claude/mcp.json
.codex/config.toml
.gemini/config.toml
.kilocode/config.toml
.antigravity/mcp.json
.vscode/mcp.json

# Claude Desktop app config (local)
claude_desktop_config/

# Build logs
build_*.log

# Throwaway test files
test_*.go
!*_test.go

# Compiled binaries (root-level only)
/flexinfer-proxy
/flexinfer-manager
/flexinfer-agent
/flexinfer-bench
/flexinfer-scheduler
/flexinfer
/flexinfer-flash-loader
/flexinfer-sched
/flexinfer-global-proxy
/flexinfer-runtime
