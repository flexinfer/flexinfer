<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loom.hud</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/cblevins/.local/bin/loom</string>
        <string>hud</string>
        <string>--port</string>
        <string>3333</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/cblevins/.config/loom/logs/hud.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/cblevins/.config/loom/logs/hud.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/cblevins</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/cblevins/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/cblevins</string>
        <key>CACHE_BACKEND</key>
        <string>redis</string>
        <key>REDIS_URL</key>
        <string>redis://localhost:6379</string>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
