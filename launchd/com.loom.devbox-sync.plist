<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loom.devbox-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/cblevins/workspace/services/loom-core/scripts/devbox-sync.sh</string>
        <string>--watch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/cblevins/.config/loom/logs/devbox-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/cblevins/.config/loom/logs/devbox-sync.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/cblevins</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/cblevins/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/cblevins</string>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
