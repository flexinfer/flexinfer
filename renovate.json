{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":separateMajorReleases",
    "group:allNonMajor"
  ],
  "labels": ["dependencies"],
  "timezone": "America/Denver",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch updates for trusted packages",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "/^k8s\\.io\\//",
        "/^sigs\\.k8s\\.io\\//",
        "/^golang\\.org\\/x\\//"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group Kubernetes packages",
      "matchPackageNames": ["/^k8s\\.io\\//"],
      "groupName": "kubernetes"
    },
    {
      "description": "Group controller-runtime with k8s",
      "matchPackageNames": ["/^sigs\\.k8s\\.io\\/controller-runtime/"],
      "groupName": "kubernetes"
    },
    {
      "description": "Group golang.org/x packages",
      "matchPackageNames": ["/^golang\\.org\\/x\\//"],
      "groupName": "golang-x"
    },
    {
      "description": "Group testing packages",
      "matchPackageNames": [
        "/^github\\.com\\/onsi\\/ginkgo/",
        "/^github\\.com\\/onsi\\/gomega/",
        "github.com/stretchr/testify"
      ],
      "groupName": "testing"
    },
    {
      "description": "Group Prometheus packages",
      "matchPackageNames": ["/^github\\.com\\/prometheus\\//"],
      "groupName": "prometheus"
    },
    {
      "description": "Pin Go version in go.mod (toolchain driven by GO_VERSION CI var instead)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    },
    {
      "description": "Track the Go toolchain pinned as GO_VERSION in .gitlab-ci.yml. govulncheck stdlib CVEs hard-block merges until the toolchain is bumped, so MR Go security/patch releases promptly (at any time, not the Monday window) rather than reactively.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["golang"],
      "matchDatasources": ["golang-version"],
      "labels": ["dependencies", "security", "go-toolchain"],
      "schedule": ["at any time"],
      "prPriority": 10
    },
    {
      "description": "Helm chart updates",
      "matchManagers": ["helm-values", "helmfile"],
      "groupName": "helm"
    },
    {
      "description": "Docker base images",
      "matchManagers": ["dockerfile"],
      "groupName": "docker"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go toolchain version pinned as the GO_VERSION CI variable, which drives GO_IMAGE (golang:${GO_VERSION}) used by the lint, test, build, and govulncheck jobs.",
      "fileMatch": ["^\\.gitlab-ci\\.yml$"],
      "matchStrings": [
        "GO_VERSION:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version"
    }
  ],
  "gomod": {
    "enabled": true,
    "postUpdateOptions": ["gomodTidy"]
  },
  "dockerfile": {
    "enabled": true,
    "fileMatch": ["(^|/|\\.)Dockerfile[^/]*$", "(^|/)Dockerfile\\.[^/]*$"]
  },
  "helm-values": {
    "enabled": true,
    "fileMatch": ["charts/.+/values\\.yaml$"]
  }
}
