# Local-only Dockerfile for building `custom-server` from the current workspace
# without fetching private sibling modules over the network.
# Build context must be the workspace root (so `libs/*` is available).
#
# Example:
#   docker build -f services/loom-core/Dockerfile.custom-server.local -t registry.harbor.lan/mcp/custom-server:<tag> .
#
# CI should continue to use `services/loom-core/Dockerfile.custom-server`.

FROM golang:1.25.10-alpine AS builder

RUN apk add --no-cache git ca-certificates
ENV GOPRIVATE=gitlab.flexinfer.ai/* \
    GONOSUMDB=gitlab.flexinfer.ai/* \
    GOSUMDB=off \
    GOFLAGS=-buildvcs=false \
    GOWORK=off

WORKDIR /src

# Local workspace modules come from the named BuildKit context `libs` and are
# wired in via go.work.
RUN mkdir -p /src/libs
COPY --from=libs mcp-go /src/libs/mcp-go
COPY --from=libs fi-mcp-kit /src/libs/fi-mcp-kit
COPY --from=libs fi-accel/go/fiaccel /src/libs/fi-accel/go/fiaccel

WORKDIR /src/services/loom-core

COPY . ./

RUN go mod edit -replace=gitlab.flexinfer.ai/libs/mcp-go=/src/libs/mcp-go && \
    go mod edit -replace=gitlab.flexinfer.ai/libs/fi-mcp-kit=/src/libs/fi-mcp-kit && \
    go mod edit -replace=gitlab.flexinfer.ai/libs/fi-accel/go/fiaccel=/src/libs/fi-accel/go/fiaccel && \
    go mod download

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/custom-server ./cmd/custom-server

RUN mkdir -p /out/services/loom-core/bin && \
    for d in cmd/mcp-*; do \
      name="$(basename "$d")"; \
      CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o "/out/services/loom-core/bin/$name" "./$d"; \
    done

FROM registry.harbor.lan/dockerhub-cache/library/alpine:3.21

RUN apk add --no-cache ca-certificates kubectl

RUN adduser -D -u 1000 mcp
USER mcp

WORKDIR /app

COPY --from=builder /out/custom-server /app/custom-server
COPY --from=builder /out/services/loom-core/bin /app/services/loom-core/bin

EXPOSE 8080

ENTRYPOINT ["/app/custom-server"]
