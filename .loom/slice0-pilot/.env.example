# Slice 0 pilot — local secrets (gitignored). Copy to `.env` and fill in.
# Get a fresh Tavily key at https://app.tavily.com (free tier ~1,000 credits/mo).
TAVILY_API_KEY=tvly-...
# Optional cost knobs (defaults are already the cheap tier):
#   TAVILY_SEARCH_DEPTH=basic   # basic=1 credit/search, advanced=2
#   GATHER_QUERIES=1            # research searches per surviving lead
#   EMAIL_QUERIES=1             # email-discovery searches per surviving lead
# To SEND (review works without these):
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password-here
# FROM_NAME=Your Name
